{
  "name": "dokufix",
  "private": true,
  "type": "module",
  "description": "Builds dist/dokufix.html from the sources under src/. See src/README.md.",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --dev --watch",
    "check": "node build.mjs --check && node tests/check-doc-styles.mjs && eslint src",
    "test": "node --test tests/*.test.mjs",
    "vergleich": "node tests/vergleich.mjs",
    "pruefung": "node tests/pruefung.mjs",
    "fixtures": "node tests/bpmn-fixtures.mjs",
    "labels": "node tests/check-label-size.mjs",
    "assistant": "node tools/bpmn-assistant/bauen.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "linkedom": "0.18.13",
    "playwright-core": "1.63.0"
  }
}
