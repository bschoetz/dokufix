<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="D" targetNamespace="http://example.org/r">
  <bpmn:collaboration id="C">
    <bpmn:participant id="P" name="Pool" processRef="Proc" />
  </bpmn:collaboration>
  <bpmn:process id="Proc" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="Lane_1" name="Oben">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ga</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Unten">
        <bpmn:flowNodeRef>c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>z</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" />
    <bpmn:task id="a" name="Erstellen" />
    <bpmn:task id="b" name="Prüfen" />
    <bpmn:exclusiveGateway id="g" name="gut?" />
    <bpmn:task id="c" name="Verteilen" />
    <bpmn:task id="d" name="Archivieren" />
    <bpmn:endEvent id="z" />
    <bpmn:sequenceFlow id="F1_s_a" sourceRef="s" targetRef="a" />
    <bpmn:sequenceFlow id="F2_a_b" sourceRef="ga" targetRef="b" />
    <bpmn:sequenceFlow id="F3_b_g" sourceRef="b" targetRef="g" />
    <bpmn:sequenceFlow id="F4_g_a" name="nein" sourceRef="g" targetRef="a" />
    <bpmn:sequenceFlow id="F5_g_b" name="fast" sourceRef="g" targetRef="b" />
    <bpmn:sequenceFlow id="F6_g_c" name="ja" sourceRef="g" targetRef="c" />
    <bpmn:sequenceFlow id="F7_a_c" name="Eilfall" sourceRef="ga" targetRef="c" />
    <bpmn:sequenceFlow id="F8_c_d" sourceRef="c" targetRef="d" />
    <bpmn:sequenceFlow id="F9_d_z" sourceRef="d" targetRef="z" />
    <bpmn:exclusiveGateway id="ga" name="Eilfall?" />
    <bpmn:sequenceFlow id="R1_a_ga" sourceRef="a" targetRef="ga" />
  </bpmn:process>
