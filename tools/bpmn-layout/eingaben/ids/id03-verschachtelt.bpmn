<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Defs" targetNamespace="http://dokufix.example/id">
  <bpmn:collaboration id="C_id03">
    <bpmn:participant id="Pa_Werk" name="Werk" processRef="P_id03" />
  </bpmn:collaboration>
  <bpmn:process id="P_id03" isExecutable="false">
    <bpmn:laneSet id="LS_id03">
      <bpmn:lane id="L_Auftrag" name="Auftrag"><bpmn:flowNodeRef>S_Auftrag</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Planen</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane name="Fertigung">
        <bpmn:childLaneSet id="LS_Fertigung">
          <bpmn:lane name="Zuschnitt"><bpmn:flowNodeRef>T_Zuschneiden</bpmn:flowNodeRef></bpmn:lane>
          <bpmn:lane name="Montage"><bpmn:flowNodeRef>T_Montieren</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Fertig</bpmn:flowNodeRef></bpmn:lane>
        </bpmn:childLaneSet>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_Auftrag" name="Auftrag da" />
    <bpmn:task id="T_Planen" name="Planen" />
    <bpmn:task id="T_Zuschneiden" name="Zuschneiden" />
    <bpmn:task id="T_Montieren" name="Montieren" />
    <bpmn:endEvent id="E_Fertig" name="Gebaut" />
    <bpmn:sequenceFlow id="f1" sourceRef="S_Auftrag" targetRef="T_Planen" />
    <bpmn:sequenceFlow id="f2" sourceRef="T_Planen" targetRef="T_Zuschneiden" />
    <bpmn:sequenceFlow id="f3" sourceRef="T_Zuschneiden" targetRef="T_Montieren" />
    <bpmn:sequenceFlow id="f4" sourceRef="T_Montieren" targetRef="E_Fertig" />
  </bpmn:process>
</bpmn:definitions>
