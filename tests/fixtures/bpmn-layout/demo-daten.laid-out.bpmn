<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitionen_Daten" targetNamespace="http://example.org/dokufix">
  <bpmn:dataStore id="D_Katalog_Speicher" name="Verbundkatalog"/>
  <bpmn:collaboration id="D_Zusammenarbeit">
    <bpmn:participant id="D_Bibliothek" name="Bibliothek" processRef="D_Bibliothek_Prozess"/>
  </bpmn:collaboration>
  <bpmn:process id="D_Bibliothek_Prozess" isExecutable="false">
    <bpmn:laneSet id="D_Bahnen">
      <bpmn:lane id="D_Ausleihe" name="Ausleihe"><bpmn:flowNodeRef>D_Eingang</bpmn:flowNodeRef><bpmn:flowNodeRef>D_Pruefen</bpmn:flowNodeRef><bpmn:flowNodeRef>D_Benachrichtigen</bpmn:flowNodeRef><bpmn:flowNodeRef>D_Bereit</bpmn:flowNodeRef><bpmn:flowNodeRef>D_Ordnung</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="D_Fernleihe" name="Fernleihe"><bpmn:flowNodeRef>D_Anfragen</bpmn:flowNodeRef><bpmn:flowNodeRef>D_Eingetroffen</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="D_Magazin" name="Magazin"><bpmn:flowNodeRef>D_Einstellen</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="D_Eingang" name="Bestellung eingegangen">
      <bpmn:dataOutputAssociation id="D_Schreibt_Bestellung"><bpmn:targetRef>D_Bestellung</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:messageEventDefinition id="D_Eingang_D"/>
    </bpmn:startEvent>
    <bpmn:task id="D_Pruefen" name="Bestellung prüfen">
      <bpmn:property id="D_Pruefen_P" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="D_Liest_Bestellung"><bpmn:sourceRef>D_Bestellung</bpmn:sourceRef><bpmn:targetRef>D_Pruefen_P</bpmn:targetRef></bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="D_Schreibt_Geprueft"><bpmn:targetRef>D_Geprueft</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="D_Anfragen" name="Partnerbibliothek anfragen">
      <bpmn:property id="D_Anfragen_P" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="D_Liest_Geprueft"><bpmn:sourceRef>D_Geprueft</bpmn:sourceRef><bpmn:targetRef>D_Anfragen_P</bpmn:targetRef></bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="D_Liest_Katalog"><bpmn:sourceRef>D_Katalog</bpmn:sourceRef><bpmn:targetRef>D_Anfragen_P</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="D_Eingetroffen" name="Buch eingetroffen">
      <bpmn:dataOutputAssociation id="D_Schreibt_Lieferschein"><bpmn:targetRef>D_Lieferschein</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:messageEventDefinition id="D_Eingetroffen_D"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="D_Einstellen" name="Buch einstellen">
      <bpmn:property id="D_Einstellen_P" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="D_Liest_Lieferschein"><bpmn:sourceRef>D_Lieferschein</bpmn:sourceRef><bpmn:targetRef>D_Einstellen_P</bpmn:targetRef></bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="D_Liest_Konto"><bpmn:sourceRef>D_Konto</bpmn:sourceRef><bpmn:targetRef>D_Einstellen_P</bpmn:targetRef></bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="D_Schreibt_Konto"><bpmn:targetRef>D_Konto</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="D_Benachrichtigen" name="Leserin benachrichtigen">
      <bpmn:property id="D_Benachrichtigen_P" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="D_Liest_Konto_Ausleihe"><bpmn:sourceRef>D_Konto</bpmn:sourceRef><bpmn:targetRef>D_Benachrichtigen_P</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="D_Bereit" name="Buch liegt bereit"/>
    <bpmn:sequenceFlow id="D_F1" sourceRef="D_Eingang" targetRef="D_Pruefen"/>
    <bpmn:sequenceFlow id="D_F2" sourceRef="D_Pruefen" targetRef="D_Anfragen"/>
    <bpmn:sequenceFlow id="D_F3" sourceRef="D_Anfragen" targetRef="D_Eingetroffen"/>
    <bpmn:sequenceFlow id="D_F4" sourceRef="D_Eingetroffen" targetRef="D_Einstellen"/>
    <bpmn:sequenceFlow id="D_F5" sourceRef="D_Einstellen" targetRef="D_Benachrichtigen"/>
    <bpmn:sequenceFlow id="D_F6" sourceRef="D_Benachrichtigen" targetRef="D_Bereit"/>
    <bpmn:dataObject id="D_Bestellung_Objekt"/>
    <bpmn:dataObjectReference id="D_Bestellung" name="Bestellung" dataObjectRef="D_Bestellung_Objekt"/>
    <bpmn:dataObjectReference id="D_Geprueft" name="Bestellung" dataObjectRef="D_Bestellung_Objekt"><bpmn:dataState id="D_Geprueft_Z" name="geprüft"/></bpmn:dataObjectReference>
    <bpmn:dataObject id="D_Lieferschein_Objekt"/>
    <bpmn:dataObjectReference id="D_Lieferschein" name="Lieferschein" dataObjectRef="D_Lieferschein_Objekt"/>
    <bpmn:dataStoreReference id="D_Katalog" name="Verbundkatalog" dataStoreRef="D_Katalog_Speicher"/>
    <bpmn:dataStoreReference id="D_Konto" name="Ausleihsystem"/>
    <bpmn:dataObject id="D_Ordnung_Objekt"/>
    <bpmn:dataObjectReference id="D_Ordnung" name="Benutzungsordnung" dataObjectRef="D_Ordnung_Objekt"/>
    <bpmn:textAnnotation id="D_Notiz_Lieferschein"><bpmn:text>Bleibt beim Buch</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="D_Zum_Lieferschein" sourceRef="D_Lieferschein" targetRef="D_Notiz_Lieferschein"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="dokufix_diagram">
    <bpmndi:BPMNPlane id="dokufix_plane" bpmnElement="D_Zusammenarbeit">
      <bpmndi:BPMNShape id="D_Bibliothek_di" bpmnElement="D_Bibliothek" isHorizontal="true"><dc:Bounds x="0" y="0" width="846" height="794"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Ausleihe_di" bpmnElement="D_Ausleihe" isHorizontal="true"><dc:Bounds x="30" y="0" width="816" height="326"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Fernleihe_di" bpmnElement="D_Fernleihe" isHorizontal="true"><dc:Bounds x="30" y="326" width="816" height="234"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Magazin_di" bpmnElement="D_Magazin" isHorizontal="true"><dc:Bounds x="30" y="560" width="816" height="234"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Eingang_di" bpmnElement="D_Eingang"><dc:Bounds x="102" y="236" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="75" y="276" width="90" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Pruefen_di" bpmnElement="D_Pruefen"><dc:Bounds x="210" y="214" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Anfragen_di" bpmnElement="D_Anfragen"><dc:Bounds x="210" y="448" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Eingetroffen_di" bpmnElement="D_Eingetroffen"><dc:Bounds x="420" y="470" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="393" y="452" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Einstellen_di" bpmnElement="D_Einstellen"><dc:Bounds x="378" y="682" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Benachrichtigen_di" bpmnElement="D_Benachrichtigen"><dc:Bounds x="546" y="214" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Bereit_di" bpmnElement="D_Bereit"><dc:Bounds x="738" y="236" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="711" y="276" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Notiz_Lieferschein_di" bpmnElement="D_Notiz_Lieferschein"><dc:Bounds x="280" y="577" width="150" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Bestellung_di" bpmnElement="D_Bestellung"><dc:Bounds x="177" y="104" width="36" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="150" y="86" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Geprueft_di" bpmnElement="D_Geprueft"><dc:Bounds x="312" y="338" width="36" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="335" y="350" width="90" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Lieferschein_di" bpmnElement="D_Lieferschein"><dc:Bounds x="480" y="572" width="36" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="507" y="590" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Katalog_di" bpmnElement="D_Katalog"><dc:Bounds x="171" y="358" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="151" y="340" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Konto_di" bpmnElement="D_Konto"><dc:Bounds x="645" y="592" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="625" y="646" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D_Ordnung_di" bpmnElement="D_Ordnung"><dc:Bounds x="104" y="12" width="36" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="73" y="66" width="99" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="D_F1_di" bpmnElement="D_F1"><di:waypoint x="138" y="254"/><di:waypoint x="210" y="254"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_F2_di" bpmnElement="D_F2"><di:waypoint x="270" y="294"/><di:waypoint x="270" y="448"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_F3_di" bpmnElement="D_F3"><di:waypoint x="330" y="488"/><di:waypoint x="420" y="488"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_F4_di" bpmnElement="D_F4"><di:waypoint x="438" y="506"/><di:waypoint x="438" y="682"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_F5_di" bpmnElement="D_F5"><di:waypoint x="498" y="722"/><di:waypoint x="606" y="722"/><di:waypoint x="606" y="294"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_F6_di" bpmnElement="D_F6"><di:waypoint x="666" y="254"/><di:waypoint x="738" y="254"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_Zum_Lieferschein_di" bpmnElement="D_Zum_Lieferschein"><di:waypoint x="480" y="597"/><di:waypoint x="430" y="597"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_Schreibt_Bestellung_di" bpmnElement="D_Schreibt_Bestellung"><di:waypoint x="129" y="239"/><di:waypoint x="180" y="154"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_Liest_Bestellung_di" bpmnElement="D_Liest_Bestellung"><di:waypoint x="210" y="154"/><di:waypoint x="246" y="214"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_Schreibt_Geprueft_di" bpmnElement="D_Schreibt_Geprueft"><di:waypoint x="321" y="294"/><di:waypoint x="321" y="338"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_Liest_Geprueft_di" bpmnElement="D_Liest_Geprueft"><di:waypoint x="321" y="388"/><di:waypoint x="321" y="448"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_Liest_Katalog_di" bpmnElement="D_Liest_Katalog"><di:waypoint x="216" y="408"/><di:waypoint x="216" y="448"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_Schreibt_Lieferschein_di" bpmnElement="D_Schreibt_Lieferschein"><di:waypoint x="447" y="504"/><di:waypoint x="484" y="572"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_Liest_Lieferschein_di" bpmnElement="D_Liest_Lieferschein"><di:waypoint x="489" y="622"/><di:waypoint x="489" y="682"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_Liest_Konto_di" bpmnElement="D_Liest_Konto"><di:waypoint x="645" y="635"/><di:waypoint x="498" y="701"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_Schreibt_Konto_di" bpmnElement="D_Schreibt_Konto"><di:waypoint x="498" y="688"/><di:waypoint x="645" y="622"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D_Liest_Konto_Ausleihe_di" bpmnElement="D_Liest_Konto_Ausleihe"><di:waypoint x="656" y="592"/><di:waypoint x="656" y="294"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
