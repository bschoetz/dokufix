    <bpmn:sequenceFlow id="F5_c_d" sourceRef="c" targetRef="d"/>
    <bpmn:sequenceFlow id="F6_d_b" sourceRef="d" targetRef="b" name="nein"/>
    <bpmn:sequenceFlow id="F7_d_gx" sourceRef="d" targetRef="gx" name="ja"/>
    <bpmn:sequenceFlow id="F8_gx_a" sourceRef="gx" targetRef="a" name="nein"/>
