      <bpmndi:BPMNShape id="Abwesenheit_di" bpmnElement="Abwesenheit"><dc:Bounds x="686" y="198" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="659" y="238" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Teilen_di" bpmnElement="Teilen"><dc:Bounds x="829" y="191" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PersoenlichAntworten_di" bpmnElement="PersoenlichAntworten"><dc:Bounds x="944" y="176" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Zusammen_di" bpmnElement="Zusammen"><dc:Bounds x="1280" y="191" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AnTouren_di" bpmnElement="AnTouren"><dc:Bounds x="1378" y="176" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Abmelden_di" bpmnElement="Abmelden"><dc:Bounds x="644" y="444" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Abgemeldet_di" bpmnElement="Abgemeldet"><dc:Bounds x="836" y="466" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="809" y="506" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Status_di" bpmnElement="Status"><dc:Bounds x="944" y="320" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MailsEnden_di" bpmnElement="MailsEnden"><dc:Bounds x="1112" y="320" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AboAnfrage_di" bpmnElement="AboAnfrage"><dc:Bounds x="210" y="588" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BeiTouren_di" bpmnElement="BeiTouren"><dc:Bounds x="1570" y="198" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1543" y="164" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
