<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Defs" targetNamespace="http://dokufix.example/vs">
  <bpmn:collaboration id="C_vs04">
    <bpmn:participant id="Pa_Lieferant" name="Lieferant" processRef="P_Lieferant" />
    <bpmn:participant id="Pa_Kunde" name="Kunde" processRef="P_Kunde" />
    <bpmn:messageFlow id="m1" name="Bestellung" sourceRef="T_Bestellen" targetRef="S_Bestellung" />
    <bpmn:messageFlow id="m2" name="Ware" sourceRef="T_Versenden" targetRef="T_Empfangen" />
  </bpmn:collaboration>
  <bpmn:process id="P_Lieferant" isExecutable="false">
    <bpmn:laneSet id="LS_Lieferant">
      <bpmn:lane id="L_Logistik" name="Logistik">
        <bpmn:childLaneSet id="LS_Logistik">
          <bpmn:lane id="L_Lager" name="Lager"><bpmn:flowNodeRef>S_Bestellung</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Kommissionieren</bpmn:flowNodeRef></bpmn:lane>
          <bpmn:lane id="L_Versand" name="Versand"><bpmn:flowNodeRef>T_Versenden</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Versandt</bpmn:flowNodeRef></bpmn:lane>
        </bpmn:childLaneSet>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_Bestellung" name="Bestellung erhalten"><bpmn:messageEventDefinition id="MED_1" /></bpmn:startEvent>
    <bpmn:task id="T_Kommissionieren" name="Ware kommissionieren" />
    <bpmn:task id="T_Versenden" name="Ware versenden" />
    <bpmn:endEvent id="E_Versandt" name="Ware versandt" />
    <bpmn:sequenceFlow id="lf1" sourceRef="S_Bestellung" targetRef="T_Kommissionieren" />
    <bpmn:sequenceFlow id="lf2" sourceRef="T_Kommissionieren" targetRef="T_Versenden" />
    <bpmn:sequenceFlow id="lf3" sourceRef="T_Versenden" targetRef="E_Versandt" />
  </bpmn:process>
  <bpmn:process id="P_Kunde" isExecutable="false">
    <bpmn:laneSet id="LS_Kunde">
      <bpmn:lane id="L_Einkauf" name="Einkauf"><bpmn:flowNodeRef>S_Bedarf</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Bestellen</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Wareneingang" name="Wareneingang"><bpmn:flowNodeRef>T_Empfangen</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Erhalten</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_Bedarf" name="Bedarf erkannt" />
    <bpmn:task id="T_Bestellen" name="Ware bestellen" />
    <bpmn:task id="T_Empfangen" name="Ware empfangen" />
    <bpmn:endEvent id="E_Erhalten" name="Ware erhalten" />
    <bpmn:sequenceFlow id="kf1" sourceRef="S_Bedarf" targetRef="T_Bestellen" />
    <bpmn:sequenceFlow id="kf2" sourceRef="T_Bestellen" targetRef="T_Empfangen" />
    <bpmn:sequenceFlow id="kf3" sourceRef="T_Empfangen" targetRef="E_Erhalten" />
  </bpmn:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="dokufix_diagram">
    <bpmndi:BPMNPlane id="dokufix_plane" bpmnElement="C_vs04">
      <bpmndi:BPMNShape id="Pa_Lieferant_di" bpmnElement="Pa_Lieferant" isHorizontal="true"><dc:Bounds x="0" y="0" width="708" height="288"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pa_Kunde_di" bpmnElement="Pa_Kunde" isHorizontal="true"><dc:Bounds x="0" y="328" width="708" height="288"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Logistik_di" bpmnElement="L_Logistik" isHorizontal="true"><dc:Bounds x="30" y="0" width="678" height="288"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Lager_di" bpmnElement="L_Lager" isHorizontal="true"><dc:Bounds x="60" y="0" width="648" height="144"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Versand_di" bpmnElement="L_Versand" isHorizontal="true"><dc:Bounds x="60" y="144" width="648" height="144"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Einkauf_di" bpmnElement="L_Einkauf" isHorizontal="true"><dc:Bounds x="30" y="328" width="678" height="144"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Wareneingang_di" bpmnElement="L_Wareneingang" isHorizontal="true"><dc:Bounds x="30" y="472" width="678" height="144"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Bestellung_di" bpmnElement="S_Bestellung"><dc:Bounds x="282" y="54" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="255" y="23" width="90" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Kommissionieren_di" bpmnElement="T_Kommissionieren"><dc:Bounds x="408" y="32" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Versenden_di" bpmnElement="T_Versenden"><dc:Bounds x="408" y="176" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_Versandt_di" bpmnElement="E_Versandt"><dc:Bounds x="600" y="198" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="573" y="238" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Bedarf_di" bpmnElement="S_Bedarf"><dc:Bounds x="132" y="382" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="105" y="422" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Bestellen_di" bpmnElement="T_Bestellen"><dc:Bounds x="240" y="360" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Empfangen_di" bpmnElement="T_Empfangen"><dc:Bounds x="408" y="504" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_Erhalten_di" bpmnElement="E_Erhalten"><dc:Bounds x="600" y="526" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="573" y="566" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="lf1_di" bpmnElement="lf1"><di:waypoint x="318" y="72"/><di:waypoint x="408" y="72"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="lf2_di" bpmnElement="lf2"><di:waypoint x="468" y="112"/><di:waypoint x="468" y="176"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="lf3_di" bpmnElement="lf3"><di:waypoint x="528" y="216"/><di:waypoint x="600" y="216"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="kf1_di" bpmnElement="kf1"><di:waypoint x="168" y="400"/><di:waypoint x="240" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="kf2_di" bpmnElement="kf2"><di:waypoint x="300" y="440"/><di:waypoint x="300" y="544"/><di:waypoint x="408" y="544"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="kf3_di" bpmnElement="kf3"><di:waypoint x="528" y="544"/><di:waypoint x="600" y="544"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m1_di" bpmnElement="m1"><di:waypoint x="300" y="360"/><di:waypoint x="300" y="90"/><bpmndi:BPMNLabel><dc:Bounds x="306" y="301" width="52" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m2_di" bpmnElement="m2"><di:waypoint x="468" y="256"/><di:waypoint x="468" y="504"/><bpmndi:BPMNLabel><dc:Bounds x="474" y="301" width="26" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
