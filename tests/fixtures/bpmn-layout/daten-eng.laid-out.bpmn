      <bpmndi:BPMNShape id="d1_di" bpmnElement="d1"><dc:Bounds x="372" y="12" width="36" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="345" y="-6" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d2_di" bpmnElement="d2"><dc:Bounds x="672" y="300" width="36" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="645" y="282" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="w_di" bpmnElement="w"><dc:Bounds x="581" y="300" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="561" y="282" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
