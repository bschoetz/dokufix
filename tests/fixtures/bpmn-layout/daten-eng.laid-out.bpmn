      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="438" y="405"/><di:waypoint x="438" y="346"/><bpmndi:BPMNLabel><dc:Bounds x="444" y="383" width="21" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="378" y="306"/><di:waypoint x="300" y="306"/><di:waypoint x="300" y="390"/></bpmndi:BPMNEdge>
