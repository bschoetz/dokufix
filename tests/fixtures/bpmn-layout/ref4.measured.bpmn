<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitionen" targetNamespace="http://example.org/dokufix">
  <bpmn:process id="Prozess" isExecutable="false">
    <bpmn:startEvent id="Los" name="Medium zurück"/>
    <bpmn:task id="Aufgabe" name="Etikett scannen"/>
    <bpmn:intermediateCatchEvent id="Warten" name="Zwei Tage"><bpmn:timerEventDefinition id="Warten_Def"/></bpmn:intermediateCatchEvent>
    <bpmn:task id="Regal" name="Zurück ins Regal"/>
    <bpmn:endEvent id="Fertig" name="Wieder ausleihbar"/>
    <bpmn:sequenceFlow id="O1" sourceRef="Los" targetRef="Aufgabe"/>
    <bpmn:sequenceFlow id="O2" sourceRef="Aufgabe" targetRef="Warten"/>
    <bpmn:sequenceFlow id="O3" sourceRef="Warten" targetRef="Regal"/>
    <bpmn:sequenceFlow id="O4" sourceRef="Regal" targetRef="Fertig"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="dokufix_diagram">
    <bpmndi:BPMNPlane id="dokufix_plane" bpmnElement="Prozess">
      <bpmndi:BPMNShape id="Los_di" bpmnElement="Los"><dc:Bounds x="-33" y="-75" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="-60" y="-35" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Aufgabe_di" bpmnElement="Aufgabe"><dc:Bounds x="63" y="-97" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Warten_di" bpmnElement="Warten"><dc:Bounds x="243" y="-75" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="216" y="-35" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Regal_di" bpmnElement="Regal"><dc:Bounds x="339" y="-97" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fertig_di" bpmnElement="Fertig"><dc:Bounds x="519" y="-75" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="492" y="-35" width="90" height="29"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="O1_di" bpmnElement="O1"><di:waypoint x="3" y="-57"/><di:waypoint x="63" y="-57"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="O2_di" bpmnElement="O2"><di:waypoint x="183" y="-57"/><di:waypoint x="243" y="-57"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="O3_di" bpmnElement="O3"><di:waypoint x="279" y="-57"/><di:waypoint x="339" y="-57"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="O4_di" bpmnElement="O4"><di:waypoint x="459" y="-57"/><di:waypoint x="519" y="-57"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
