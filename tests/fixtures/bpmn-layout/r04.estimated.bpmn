    <bpmn:task id="a" name="Warten vorbereiten"/>
    <bpmn:intermediateCatchEvent id="i1" name="Frist abgelaufen"/>
    <bpmn:task id="b" name="Erinnern"/>
    <bpmn:intermediateThrowEvent id="i2" name="Erinnerung gesendet"/>
    <bpmn:endEvent id="z" name="Ende"/>
