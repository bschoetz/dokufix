<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitionen_Assoziationen" targetNamespace="http://example.org/dokufix">
  <bpmn:signal id="AS_Signal" name="Gast"/>
  <bpmn:collaboration id="AS_Zusammenarbeit">
    <bpmn:participant id="AS_Pool" name="Gasthaus" processRef="AS_Prozess"/>
  </bpmn:collaboration>
  <bpmn:process id="AS_Prozess" isExecutable="false">
    <bpmn:laneSet id="AS_Bahnen">
      <bpmn:lane id="AS_Empfang" name="Empfang">
        <bpmn:flowNodeRef>AS_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Platz</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Reservieren</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Loesen</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Melden</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Rechnung</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Ende</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="AS_Kueche" name="Küche">
        <bpmn:flowNodeRef>AS_Koch_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Hoeren</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Kochen</bpmn:flowNodeRef><bpmn:flowNodeRef>AS_Koch_Ende</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="AS_Start" name="Gast kommt"/>
    <bpmn:exclusiveGateway id="AS_Platz" name="Platz frei?" default="AS_F_Frei"/>
    <bpmn:task id="AS_Reservieren" name="Tisch reservieren"/>
    <bpmn:boundaryEvent id="AS_Komp" attachedToRef="AS_Reservieren"><bpmn:compensateEventDefinition id="AS_Komp_Def"/></bpmn:boundaryEvent>
    <bpmn:task id="AS_Loesen" name="Reservierung lösen" isForCompensation="true"/>
    <bpmn:intermediateThrowEvent id="AS_Melden" name="Gast angemeldet"><bpmn:signalEventDefinition id="AS_Melden_Def" signalRef="AS_Signal"/></bpmn:intermediateThrowEvent>
    <bpmn:task id="AS_Rechnung" name="Rechnung schreiben"/>
    <bpmn:endEvent id="AS_Ende" name="Gast geht"/>
    <bpmn:startEvent id="AS_Koch_Start" name="Schicht beginnt"><bpmn:timerEventDefinition id="AS_Koch_Zeit"/></bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="AS_Hoeren" name="Anmeldung gehört"><bpmn:signalEventDefinition id="AS_Hoeren_Def" signalRef="AS_Signal"/></bpmn:intermediateCatchEvent>
    <bpmn:task id="AS_Kochen" name="Essen kochen" default="AS_F_Fertig"/>
    <bpmn:endEvent id="AS_Koch_Ende" name="Essen serviert"/>
    <bpmn:dataStoreReference id="AS_Kasse" name="Kassensystem"/>
    <bpmn:sequenceFlow id="AS_F1" sourceRef="AS_Start" targetRef="AS_Platz"/>
    <bpmn:sequenceFlow id="AS_F_Warten" sourceRef="AS_Platz" targetRef="AS_Platz"/>
    <bpmn:sequenceFlow id="AS_F_Frei" sourceRef="AS_Platz" targetRef="AS_Reservieren"/>
    <bpmn:sequenceFlow id="AS_F2" sourceRef="AS_Reservieren" targetRef="AS_Melden"/>
    <bpmn:sequenceFlow id="AS_F3" sourceRef="AS_Melden" targetRef="AS_Rechnung"/>
    <bpmn:sequenceFlow id="AS_F4" sourceRef="AS_Rechnung" targetRef="AS_Ende"/>
    <bpmn:sequenceFlow id="AS_K1" sourceRef="AS_Koch_Start" targetRef="AS_Hoeren"/>
    <bpmn:sequenceFlow id="AS_K2" sourceRef="AS_Hoeren" targetRef="AS_Kochen"/>
    <bpmn:sequenceFlow id="AS_F_Abschmecken" name="abschmecken" sourceRef="AS_Kochen" targetRef="AS_Kochen"/>
    <bpmn:sequenceFlow id="AS_F_Fertig" sourceRef="AS_Kochen" targetRef="AS_Koch_Ende"/>
    <bpmn:association id="AS_Signal_Linie" sourceRef="AS_Melden" targetRef="AS_Hoeren"/>
    <bpmn:association id="AS_Komp_Linie" associationDirection="One" sourceRef="AS_Komp" targetRef="AS_Loesen"/>
    <bpmn:association id="AS_Kasse_Linie" sourceRef="AS_Kasse" targetRef="AS_Rechnung"/>
    <bpmn:association id="AS_Zum_Fluss" sourceRef="AS_Rechnung" targetRef="AS_F3"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="dokufix_diagram">
    <bpmndi:BPMNPlane id="dokufix_plane" bpmnElement="AS_Zusammenarbeit">
      <bpmndi:BPMNShape id="AS_Pool_di" bpmnElement="AS_Pool" isHorizontal="true"><dc:Bounds x="0" y="-28" width="1146" height="442"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AS_Empfang_di" bpmnElement="AS_Empfang" isHorizontal="true"><dc:Bounds x="30" y="-28" width="1116" height="288"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AS_Kueche_di" bpmnElement="AS_Kueche" isHorizontal="true"><dc:Bounds x="30" y="260" width="1116" height="154"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AS_Start_di" bpmnElement="AS_Start"><dc:Bounds x="102" y="152" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="75" y="192" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AS_Platz_di" bpmnElement="AS_Platz" isMarkerVisible="true"><dc:Bounds x="413" y="145" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="393" y="199" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AS_Reservieren_di" bpmnElement="AS_Reservieren"><dc:Bounds x="546" y="130" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AS_Loesen_di" bpmnElement="AS_Loesen"><dc:Bounds x="210" y="130" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AS_Melden_di" bpmnElement="AS_Melden"><dc:Bounds x="738" y="152" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="711" y="192" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AS_Rechnung_di" bpmnElement="AS_Rechnung"><dc:Bounds x="846" y="130" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AS_Ende_di" bpmnElement="AS_Ende"><dc:Bounds x="1038" y="152" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1011" y="192" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AS_Koch_Start_di" bpmnElement="AS_Koch_Start"><dc:Bounds x="102" y="324" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="75" y="364" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AS_Hoeren_di" bpmnElement="AS_Hoeren"><dc:Bounds x="252" y="324" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="225" y="364" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AS_Kochen_di" bpmnElement="AS_Kochen"><dc:Bounds x="378" y="302" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AS_Koch_Ende_di" bpmnElement="AS_Koch_Ende"><dc:Bounds x="1038" y="324" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1011" y="364" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AS_Komp_di" bpmnElement="AS_Komp"><dc:Bounds x="588" y="192" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AS_Kasse_di" bpmnElement="AS_Kasse"><dc:Bounds x="881" y="2" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="861" y="-16" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="AS_F1_di" bpmnElement="AS_F1"><di:waypoint x="120" y="152"/><di:waypoint x="120" y="100"/><di:waypoint x="438" y="100"/><di:waypoint x="438" y="145"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AS_F_Frei_di" bpmnElement="AS_F_Frei"><di:waypoint x="463" y="170"/><di:waypoint x="546" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AS_F2_di" bpmnElement="AS_F2"><di:waypoint x="666" y="170"/><di:waypoint x="738" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AS_F3_di" bpmnElement="AS_F3"><di:waypoint x="774" y="170"/><di:waypoint x="846" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AS_F4_di" bpmnElement="AS_F4"><di:waypoint x="966" y="170"/><di:waypoint x="1038" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AS_K1_di" bpmnElement="AS_K1"><di:waypoint x="138" y="342"/><di:waypoint x="252" y="342"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AS_K2_di" bpmnElement="AS_K2"><di:waypoint x="288" y="342"/><di:waypoint x="378" y="342"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AS_F_Fertig_di" bpmnElement="AS_F_Fertig"><di:waypoint x="498" y="342"/><di:waypoint x="1038" y="342"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AS_F_Warten_di" bpmnElement="AS_F_Warten"><di:waypoint x="450" y="157"/><di:waypoint x="483" y="157"/><di:waypoint x="483" y="125"/><di:waypoint x="438" y="125"/><di:waypoint x="438" y="145"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AS_F_Abschmecken_di" bpmnElement="AS_F_Abschmecken"><di:waypoint x="498" y="322"/><di:waypoint x="518" y="322"/><di:waypoint x="518" y="282"/><di:waypoint x="468" y="282"/><di:waypoint x="468" y="302"/><bpmndi:BPMNLabel><dc:Bounds x="459" y="264" width="68" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AS_Signal_Linie_di" bpmnElement="AS_Signal_Linie"><di:waypoint x="739" y="176"/><di:waypoint x="287" y="336"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AS_Komp_Linie_di" bpmnElement="AS_Komp_Linie"><di:waypoint x="590" y="201"/><di:waypoint x="330" y="201"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AS_Kasse_Linie_di" bpmnElement="AS_Kasse_Linie"><di:waypoint x="906" y="52"/><di:waypoint x="906" y="130"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
