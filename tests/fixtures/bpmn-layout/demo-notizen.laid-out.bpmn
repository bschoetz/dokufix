<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitionen_Notizen" targetNamespace="http://example.org/dokufix">
  <bpmn:collaboration id="N_Zusammenarbeit">
    <bpmn:participant id="N_Kundin" name="Kundin" processRef="N_Kundin_Prozess"/>
    <bpmn:participant id="N_Werkstatt" name="Werkstatt" processRef="N_Werkstatt_Prozess"/>
    <bpmn:participant id="N_Versicherung" name="Versicherung"/>
    <bpmn:messageFlow id="N_Auftrag" name="Auftrag" sourceRef="N_Bringen" targetRef="N_Annehmen"/>
    <bpmn:messageFlow id="N_Rechnung" name="Rechnung" sourceRef="N_Abrechnen" targetRef="N_Bezahlen"/>
    <bpmn:messageFlow id="N_Meldung" sourceRef="N_Abrechnen" targetRef="N_Versicherung"/>
    <bpmn:textAnnotation id="N_Notiz_Pool"><bpmn:text>Meisterbetrieb seit 1987</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="N_Zur_Pool" sourceRef="N_Werkstatt" targetRef="N_Notiz_Pool"/>
    <bpmn:textAnnotation id="N_Notiz_Box"><bpmn:text>Nur bei Unfallschäden</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="N_Zur_Box" sourceRef="N_Notiz_Box" targetRef="N_Versicherung"/>
    <bpmn:textAnnotation id="N_Notiz_Auftrag"><bpmn:text>Schriftlich, mit Unterschrift</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="N_Zum_Auftrag" sourceRef="N_Auftrag" targetRef="N_Notiz_Auftrag"/>
  </bpmn:collaboration>
  <bpmn:process id="N_Kundin_Prozess" isExecutable="false">
    <bpmn:startEvent id="N_Start" name="Auto macht Geräusche"/>
    <bpmn:task id="N_Bringen" name="Auto bringen"/>
    <bpmn:task id="N_Bezahlen" name="Rechnung bezahlen"/>
    <bpmn:endEvent id="N_Ende" name="Auto zurück"/>
    <bpmn:sequenceFlow id="N_K1" sourceRef="N_Start" targetRef="N_Bringen"/>
    <bpmn:sequenceFlow id="N_K2" sourceRef="N_Bringen" targetRef="N_Bezahlen"/>
    <bpmn:sequenceFlow id="N_K3" sourceRef="N_Bezahlen" targetRef="N_Ende"/>
  </bpmn:process>
  <bpmn:process id="N_Werkstatt_Prozess" isExecutable="false">
    <bpmn:laneSet id="N_Bahnen">
      <bpmn:lane id="N_Annahme" name="Annahme"><bpmn:flowNodeRef>N_Annehmen</bpmn:flowNodeRef><bpmn:flowNodeRef>N_Abrechnen</bpmn:flowNodeRef><bpmn:flowNodeRef>N_Fertig</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="N_Technik" name="Technik"><bpmn:flowNodeRef>N_Pruefen</bpmn:flowNodeRef><bpmn:flowNodeRef>N_Frist</bpmn:flowNodeRef><bpmn:flowNodeRef>N_Melden</bpmn:flowNodeRef><bpmn:flowNodeRef>N_Gemeldet</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="N_Annehmen" name="Auftrag da"><bpmn:messageEventDefinition id="N_Annehmen_D"/></bpmn:startEvent>
    <bpmn:task id="N_Pruefen" name="Fehler suchen und beheben"/>
    <bpmn:boundaryEvent id="N_Frist" name="Ein Tag" cancelActivity="false" attachedToRef="N_Pruefen"><bpmn:timerEventDefinition id="N_Frist_D"/></bpmn:boundaryEvent>
    <bpmn:task id="N_Melden" name="Kundin anrufen"/>
    <bpmn:endEvent id="N_Gemeldet" name="Angerufen"/>
    <bpmn:task id="N_Abrechnen" name="Abrechnen"/>
    <bpmn:endEvent id="N_Fertig" name="Erledigt"/>
    <bpmn:sequenceFlow id="N_W1" sourceRef="N_Annehmen" targetRef="N_Pruefen"/>
    <bpmn:sequenceFlow id="N_W2" sourceRef="N_Pruefen" targetRef="N_Abrechnen" name="behoben"/>
    <bpmn:sequenceFlow id="N_W3" sourceRef="N_Abrechnen" targetRef="N_Fertig"/>
    <bpmn:sequenceFlow id="N_W4" sourceRef="N_Frist" targetRef="N_Melden"/>
    <bpmn:sequenceFlow id="N_W5" sourceRef="N_Melden" targetRef="N_Gemeldet"/>
    <bpmn:textAnnotation id="N_Notiz_Pruefen"><bpmn:text>Mit dem Diagnosegerät</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="N_Zum_Pruefen" sourceRef="N_Pruefen" targetRef="N_Notiz_Pruefen"/>
    <bpmn:textAnnotation id="N_Notiz_Probe"><bpmn:text>Probefahrt nicht vergessen</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="N_Zur_Probe" sourceRef="N_Notiz_Probe" targetRef="N_Pruefen"/>
    <bpmn:textAnnotation id="N_Notiz_Frist"><bpmn:text>Ab Annahme gerechnet</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="N_Zur_Frist" sourceRef="N_Frist" targetRef="N_Notiz_Frist"/>
    <bpmn:textAnnotation id="N_Notiz_Fluss"><bpmn:text>Mit Protokoll der Messwerte</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="N_Zum_Fluss" sourceRef="N_W2" targetRef="N_Notiz_Fluss"/>
    <bpmn:textAnnotation id="N_Notiz_Leer"/>
    <bpmn:association id="N_Zur_Leeren" sourceRef="N_Abrechnen" targetRef="N_Notiz_Leer"/>
    <bpmn:textAnnotation id="N_Notiz_Allein"><bpmn:text>Werkstattordnung, Stand 2026</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="dokufix_diagram">
    <bpmndi:BPMNPlane id="dokufix_plane" bpmnElement="N_Zusammenarbeit">
      <bpmndi:BPMNShape id="N_Kundin_di" bpmnElement="N_Kundin" isHorizontal="true"><dc:Bounds x="-32" y="0" width="721" height="147"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Werkstatt_di" bpmnElement="N_Werkstatt" isHorizontal="true"><dc:Bounds x="-32" y="187" width="721" height="568"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Versicherung_di" bpmnElement="N_Versicherung" isHorizontal="true"><dc:Bounds x="-32" y="795" width="721" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Annahme_di" bpmnElement="N_Annahme" isHorizontal="true"><dc:Bounds x="-2" y="187" width="691" height="264"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Technik_di" bpmnElement="N_Technik" isHorizontal="true"><dc:Bounds x="-2" y="451" width="691" height="304"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Start_di" bpmnElement="N_Start"><dc:Bounds x="102" y="54" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="75" y="94" width="90" height="41"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Bringen_di" bpmnElement="N_Bringen"><dc:Bounds x="210" y="32" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Bezahlen_di" bpmnElement="N_Bezahlen"><dc:Bounds x="378" y="32" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Ende_di" bpmnElement="N_Ende"><dc:Bounds x="570" y="54" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="543" y="94" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Annehmen_di" bpmnElement="N_Annehmen"><dc:Bounds x="252" y="361" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="275" y="372" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Pruefen_di" bpmnElement="N_Pruefen"><dc:Bounds x="210" y="501" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Melden_di" bpmnElement="N_Melden"><dc:Bounds x="378" y="643" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Gemeldet_di" bpmnElement="N_Gemeldet"><dc:Bounds x="570" y="665" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="543" y="705" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Abrechnen_di" bpmnElement="N_Abrechnen"><dc:Bounds x="378" y="339" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Fertig_di" bpmnElement="N_Fertig"><dc:Bounds x="570" y="361" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="543" y="401" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Frist_di" bpmnElement="N_Frist"><dc:Bounds x="252" y="563" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="264" y="585" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Notiz_Pool_di" bpmnElement="N_Notiz_Pool"><dc:Bounds x="739" y="187" width="150" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Notiz_Box_di" bpmnElement="N_Notiz_Box"><dc:Bounds x="739" y="795" width="150" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Notiz_Auftrag_di" bpmnElement="N_Notiz_Auftrag"><dc:Bounds x="95" y="203" width="150" height="43"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Notiz_Pruefen_di" bpmnElement="N_Notiz_Pruefen"><dc:Bounds x="110" y="631" width="150" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Notiz_Probe_di" bpmnElement="N_Notiz_Probe"><dc:Bounds x="10" y="520" width="150" height="43"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Notiz_Frist_di" bpmnElement="N_Notiz_Frist"><dc:Bounds x="338" y="561" width="150" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Notiz_Fluss_di" bpmnElement="N_Notiz_Fluss"><dc:Bounds x="527" y="520" width="150" height="43"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_Notiz_Allein_di" bpmnElement="N_Notiz_Allein"><dc:Bounds x="72" y="252" width="150" height="43"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="N_K1_di" bpmnElement="N_K1"><di:waypoint x="138" y="72"/><di:waypoint x="210" y="72"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_K2_di" bpmnElement="N_K2"><di:waypoint x="330" y="72"/><di:waypoint x="378" y="72"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_K3_di" bpmnElement="N_K3"><di:waypoint x="498" y="72"/><di:waypoint x="570" y="72"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_W1_di" bpmnElement="N_W1"><di:waypoint x="270" y="397"/><di:waypoint x="270" y="501"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_W2_di" bpmnElement="N_W2"><di:waypoint x="330" y="541"/><di:waypoint x="423" y="541"/><di:waypoint x="423" y="419"/><bpmndi:BPMNLabel><dc:Bounds x="429" y="473" width="43" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_W3_di" bpmnElement="N_W3"><di:waypoint x="498" y="379"/><di:waypoint x="570" y="379"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_W4_di" bpmnElement="N_W4"><di:waypoint x="270" y="599"/><di:waypoint x="270" y="683"/><di:waypoint x="378" y="683"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_W5_di" bpmnElement="N_W5"><di:waypoint x="498" y="683"/><di:waypoint x="570" y="683"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_Auftrag_di" bpmnElement="N_Auftrag"><di:waypoint x="270" y="112"/><di:waypoint x="270" y="361"/><bpmndi:BPMNLabel><dc:Bounds x="276" y="160" width="36" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_Rechnung_di" bpmnElement="N_Rechnung"><di:waypoint x="438" y="339"/><di:waypoint x="438" y="112"/><bpmndi:BPMNLabel><dc:Bounds x="444" y="160" width="51" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_Meldung_di" bpmnElement="N_Meldung"><di:waypoint x="453" y="419"/><di:waypoint x="453" y="431"/><di:waypoint x="510" y="431"/><di:waypoint x="510" y="795"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_Zur_Pool_di" bpmnElement="N_Zur_Pool"><di:waypoint x="689" y="207"/><di:waypoint x="739" y="207"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_Zur_Box_di" bpmnElement="N_Zur_Box"><di:waypoint x="739" y="815"/><di:waypoint x="689" y="815"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_Zum_Auftrag_di" bpmnElement="N_Zum_Auftrag"><di:waypoint x="270" y="178"/><di:waypoint x="170" y="203"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_Zum_Pruefen_di" bpmnElement="N_Zum_Pruefen"><di:waypoint x="222" y="581"/><di:waypoint x="185" y="631"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_Zur_Probe_di" bpmnElement="N_Zur_Probe"><di:waypoint x="160" y="542"/><di:waypoint x="210" y="542"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_Zur_Frist_di" bpmnElement="N_Zur_Frist"><di:waypoint x="288" y="581"/><di:waypoint x="338" y="581"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="N_Zum_Fluss_di" bpmnElement="N_Zum_Fluss"><di:waypoint x="377" y="541"/><di:waypoint x="527" y="542"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
