<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Stoerung" targetNamespace="http://example.com/bpmn">
  <bpmn:process id="Process_Stoerung" name="Störungsbehebung IT-Support" isExecutable="false">
    <bpmn:startEvent id="Start_Meldung" name="Störungsmeldung eingegangen">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Klassifizieren" name="Störung klassifizieren">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="Sub_Behebung" name="Störung beheben">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:startEvent id="Sub_Start"/>
      <bpmn:task id="Sub_Diagnose" name="Ursache suchen und beheben"/>
      <bpmn:endEvent id="Sub_Ende"/>
      <bpmn:sequenceFlow id="Sub_F1" sourceRef="Sub_Start" targetRef="Sub_Diagnose"/>
      <bpmn:sequenceFlow id="Sub_F2" sourceRef="Sub_Diagnose" targetRef="Sub_Ende"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_Zeit" name="Mehr als 4 Stunden" cancelActivity="false" attachedToRef="Sub_Behebung">
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_4h">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Hardware" name="Hardwaretausch nötig" cancelActivity="true" attachedToRef="Sub_Behebung">
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_Hardware" />
    </bpmn:boundaryEvent>
    <bpmn:task id="Task_VerzoegerungInfo" name="Kunden über Verzögerung informieren">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Info" name="Kunde informiert">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Techniker" name="Techniker vor Ort beauftragen">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_KundeInfo" name="Kunden informieren">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Hardware" name="Techniker beauftragt, Kunde informiert">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Schliessen" name="Ticket schließen">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Geschlossen" name="Ticket geschlossen">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Meldung" targetRef="Task_Klassifizieren" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Klassifizieren" targetRef="Sub_Behebung" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Sub_Behebung" targetRef="Task_Schliessen" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Boundary_Zeit" targetRef="Task_VerzoegerungInfo" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_VerzoegerungInfo" targetRef="End_Info" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Boundary_Hardware" targetRef="Task_Techniker" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Techniker" targetRef="Task_KundeInfo" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_KundeInfo" targetRef="End_Hardware" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Schliessen" targetRef="End_Geschlossen" />
  </bpmn:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="dokufix_diagram">
    <bpmndi:BPMNPlane id="dokufix_plane" bpmnElement="Process_Stoerung">
      <bpmndi:BPMNShape id="Start_Meldung_di" bpmnElement="Start_Meldung"><dc:Bounds x="102" y="72" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="75" y="112" width="90" height="29"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Klassifizieren_di" bpmnElement="Task_Klassifizieren"><dc:Bounds x="210" y="50" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_Behebung_di" bpmnElement="Sub_Behebung"><dc:Bounds x="378" y="50" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerzoegerungInfo_di" bpmnElement="Task_VerzoegerungInfo"><dc:Bounds x="546" y="192" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Info_di" bpmnElement="End_Info"><dc:Bounds x="906" y="214" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="879" y="254" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Techniker_di" bpmnElement="Task_Techniker"><dc:Bounds x="546" y="316" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KundeInfo_di" bpmnElement="Task_KundeInfo"><dc:Bounds x="714" y="316" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Hardware_di" bpmnElement="End_Hardware"><dc:Bounds x="906" y="338" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="879" y="378" width="90" height="44"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Schliessen_di" bpmnElement="Task_Schliessen"><dc:Bounds x="546" y="50" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Geschlossen_di" bpmnElement="End_Geschlossen"><dc:Bounds x="906" y="72" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="879" y="112" width="90" height="29"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_Zeit_di" bpmnElement="Boundary_Zeit"><dc:Bounds x="448" y="112" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="469" y="134" width="90" height="29"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_Hardware_di" bpmnElement="Boundary_Hardware"><dc:Bounds x="392" y="112" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="302" y="134" width="90" height="29"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="138" y="90"/><di:waypoint x="210" y="90"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="330" y="90"/><di:waypoint x="378" y="90"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="498" y="90"/><di:waypoint x="546" y="90"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="466" y="148"/><di:waypoint x="466" y="232"/><di:waypoint x="546" y="232"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="666" y="232"/><di:waypoint x="906" y="232"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="410" y="148"/><di:waypoint x="410" y="356"/><di:waypoint x="546" y="356"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="666" y="356"/><di:waypoint x="714" y="356"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="834" y="356"/><di:waypoint x="906" y="356"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="666" y="90"/><di:waypoint x="906" y="90"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
