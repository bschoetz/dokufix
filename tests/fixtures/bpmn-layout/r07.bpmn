<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="D" targetNamespace="http://example.org/r">
  <bpmn:collaboration id="C"><bpmn:participant id="P" name="Pool" processRef="Proc"/></bpmn:collaboration>
  <bpmn:process id="Proc" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="Lane_1" name="Bahn"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>a</bpmn:flowNodeRef><bpmn:flowNodeRef>b</bpmn:flowNodeRef><bpmn:flowNodeRef>c</bpmn:flowNodeRef><bpmn:flowNodeRef>z</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s"/>
    <bpmn:task id="a" name="Senden"/>
    <bpmn:task id="b" name="Empfangen"/>
    <bpmn:task id="c" name="Bestätigen"/>
    <bpmn:endEvent id="z"/>
    <bpmn:sequenceFlow id="F1_s_a" sourceRef="s" targetRef="a"/>
    <bpmn:sequenceFlow id="F2_a_b" sourceRef="a" targetRef="b" name="Kanal 1"/>
    <bpmn:sequenceFlow id="F3_a_b" sourceRef="a" targetRef="b" name="Kanal 2"/>
    <bpmn:sequenceFlow id="F4_b_a" sourceRef="b" targetRef="a" name="Fehler"/>
    <bpmn:sequenceFlow id="F5_b_c" sourceRef="b" targetRef="c"/>
    <bpmn:sequenceFlow id="F6_c_a" sourceRef="c" targetRef="a" name="Rückfrage"/>
    <bpmn:sequenceFlow id="F7_c_z" sourceRef="c" targetRef="z"/>
  </bpmn:process>
</bpmn:definitions>
