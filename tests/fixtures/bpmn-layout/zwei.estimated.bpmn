<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitionen" targetNamespace="http://example.org/dokufix">
  <bpmn:collaboration id="Zusammenarbeit">
    <bpmn:participant id="Erwerbung" name="Anschaffungswunsch" processRef="Prozess_Erwerbung"/>
  </bpmn:collaboration>
  <bpmn:process id="Prozess_Erwerbung" isExecutable="false">
    <bpmn:laneSet id="Bahnen">
      <bpmn:lane id="Z_Erwerbung" name="Erwerbung"><bpmn:flowNodeRef>Z_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Z_Aufnehmen</bpmn:flowNodeRef><bpmn:flowNodeRef>Z_Suchen</bpmn:flowNodeRef><bpmn:flowNodeRef>Z_Gefunden</bpmn:flowNodeRef><bpmn:flowNodeRef>Z_Preis</bpmn:flowNodeRef><bpmn:flowNodeRef>Z_Frei</bpmn:flowNodeRef><bpmn:flowNodeRef>Z_Bestellen</bpmn:flowNodeRef><bpmn:flowNodeRef>Z_Ende</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Z_Leserin" name="Leserin"><bpmn:flowNodeRef>Z_Absage</bpmn:flowNodeRef><bpmn:flowNodeRef>Z_Abgesagt</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Z_Start" name="Wunsch eingegangen"/>
    <bpmn:task id="Z_Aufnehmen" name="Wunsch aufnehmen"/>
    <bpmn:task id="Z_Suchen" name="Titel suchen"/>
    <bpmn:exclusiveGateway id="Z_Gefunden" name="Gefunden?"/>
    <bpmn:task id="Z_Preis" name="Preis prüfen"/>
    <bpmn:exclusiveGateway id="Z_Frei" name="Freigegeben?"/>
    <bpmn:task id="Z_Bestellen" name="Bestellen"/>
    <bpmn:endEvent id="Z_Ende" name="Bestellt"/>
    <bpmn:sendTask id="Z_Absage" name="Absage schreiben"/>
    <bpmn:endEvent id="Z_Abgesagt" name="Abgesagt"/>
    <bpmn:sequenceFlow id="Z1" sourceRef="Z_Start" targetRef="Z_Aufnehmen"/>
    <bpmn:sequenceFlow id="Z2" sourceRef="Z_Aufnehmen" targetRef="Z_Suchen"/>
    <bpmn:sequenceFlow id="Z3" sourceRef="Z_Suchen" targetRef="Z_Gefunden"/>
    <bpmn:sequenceFlow id="Z4" sourceRef="Z_Gefunden" targetRef="Z_Preis" name="ja"/>
    <bpmn:sequenceFlow id="Z5" sourceRef="Z_Gefunden" targetRef="Z_Suchen" name="nein"/>
    <bpmn:sequenceFlow id="Z10" sourceRef="Z_Gefunden" targetRef="Z_Absage" name="vergriffen"/>
    <bpmn:sequenceFlow id="Z6" sourceRef="Z_Preis" targetRef="Z_Frei"/>
    <bpmn:sequenceFlow id="Z7" sourceRef="Z_Frei" targetRef="Z_Bestellen" name="ja"/>
    <bpmn:sequenceFlow id="Z8" sourceRef="Z_Frei" targetRef="Z_Aufnehmen" name="nein"/>
    <bpmn:sequenceFlow id="Z9" sourceRef="Z_Bestellen" targetRef="Z_Ende"/>
    <bpmn:sequenceFlow id="Z11" sourceRef="Z_Absage" targetRef="Z_Abgesagt"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="dokufix_diagram">
    <bpmndi:BPMNPlane id="dokufix_plane" bpmnElement="Zusammenarbeit">
      <bpmndi:BPMNShape id="Erwerbung_di" bpmnElement="Erwerbung" isHorizontal="true"><dc:Bounds x="0" y="0" width="1280" height="296"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_Erwerbung_di" bpmnElement="Z_Erwerbung" isHorizontal="true"><dc:Bounds x="30" y="0" width="1250" height="152"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_Leserin_di" bpmnElement="Z_Leserin" isHorizontal="true"><dc:Bounds x="30" y="152" width="1250" height="144"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_Start_di" bpmnElement="Z_Start"><dc:Bounds x="102" y="62" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="75" y="102" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_Aufnehmen_di" bpmnElement="Z_Aufnehmen"><dc:Bounds x="210" y="40" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_Suchen_di" bpmnElement="Z_Suchen"><dc:Bounds x="378" y="40" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_Gefunden_di" bpmnElement="Z_Gefunden" isMarkerVisible="true"><dc:Bounds x="581" y="55" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="618" y="38" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_Preis_di" bpmnElement="Z_Preis"><dc:Bounds x="714" y="40" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_Frei_di" bpmnElement="Z_Frei" isMarkerVisible="true"><dc:Bounds x="882" y="55" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="862" y="109" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_Bestellen_di" bpmnElement="Z_Bestellen"><dc:Bounds x="980" y="40" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_Ende_di" bpmnElement="Z_Ende"><dc:Bounds x="1172" y="62" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1145" y="102" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_Absage_di" bpmnElement="Z_Absage"><dc:Bounds x="546" y="184" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Z_Abgesagt_di" bpmnElement="Z_Abgesagt"><dc:Bounds x="1172" y="206" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1145" y="246" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Z1_di" bpmnElement="Z1"><di:waypoint x="138" y="80"/><di:waypoint x="210" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Z2_di" bpmnElement="Z2"><di:waypoint x="330" y="80"/><di:waypoint x="378" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Z3_di" bpmnElement="Z3"><di:waypoint x="498" y="80"/><di:waypoint x="581" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Z4_di" bpmnElement="Z4"><di:waypoint x="631" y="80"/><di:waypoint x="714" y="80"/><bpmndi:BPMNLabel><dc:Bounds x="641" y="61" width="13" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Z5_di" bpmnElement="Z5"><di:waypoint x="606" y="55"/><di:waypoint x="606" y="28"/><di:waypoint x="438" y="28"/><di:waypoint x="438" y="40"/><bpmndi:BPMNLabel><dc:Bounds x="570" y="32" width="26" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Z10_di" bpmnElement="Z10"><di:waypoint x="606" y="105"/><di:waypoint x="606" y="184"/><bpmndi:BPMNLabel><dc:Bounds x="612" y="113" width="66" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Z6_di" bpmnElement="Z6"><di:waypoint x="834" y="80"/><di:waypoint x="882" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Z7_di" bpmnElement="Z7"><di:waypoint x="932" y="80"/><di:waypoint x="980" y="80"/><bpmndi:BPMNLabel><dc:Bounds x="942" y="61" width="13" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Z8_di" bpmnElement="Z8"><di:waypoint x="907" y="55"/><di:waypoint x="907" y="12"/><di:waypoint x="270" y="12"/><di:waypoint x="270" y="40"/><bpmndi:BPMNLabel><dc:Bounds x="871" y="16" width="26" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Z9_di" bpmnElement="Z9"><di:waypoint x="1100" y="80"/><di:waypoint x="1172" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Z11_di" bpmnElement="Z11"><di:waypoint x="666" y="224"/><di:waypoint x="1172" y="224"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
