    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Kontrolle" targetRef="GW_Geheilt" />
    <bpmn:sequenceFlow id="Flow_15" name="nein" sourceRef="GW_Geheilt" targetRef="GW_Merge_Behandlung" />
