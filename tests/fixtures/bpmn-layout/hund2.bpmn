    <bpmn:sequenceFlow id="Flow_23" name="ja" sourceRef="GW_Versuche" targetRef="Task_AbbruchDok" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_AbbruchDok" targetRef="GW_Merge_Ende" />
    <bpmn:sequenceFlow id="Flow_25" name="nein" sourceRef="GW_Versuche" targetRef="GW_Merge_Ruhig" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="GW_Merge_Zitze" targetRef="Task_Melken" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_Melken" targetRef="Task_Abgeben" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_Abgeben" targetRef="GW_Fluss" />
    <bpmn:sequenceFlow id="Flow_29" name="ja" sourceRef="GW_Fluss" targetRef="GW_Alle" />
    <bpmn:sequenceFlow id="Flow_30" name="nein" sourceRef="GW_Fluss" targetRef="Task_Anregen" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_Anregen" targetRef="GW_Merge_Zitze" />
    <bpmn:sequenceFlow id="Flow_32" name="nein" sourceRef="GW_Alle" targetRef="GW_Merge_Zitze" />
