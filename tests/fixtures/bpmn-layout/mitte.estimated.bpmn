<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitionen" targetNamespace="http://example.org/dokufix">
  <bpmn:collaboration id="Zusammenarbeit">
    <bpmn:participant id="Fernleihe" name="Fernleihe" processRef="Prozess_Fernleihe"/>
  </bpmn:collaboration>
  <bpmn:process id="Prozess_Fernleihe" isExecutable="false">
    <bpmn:laneSet id="Bahnen">
      <bpmn:lane id="F_Leserin" name="Leserin"><bpmn:flowNodeRef>F_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>F_Abholen</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="F_Theke" name="Theke"><bpmn:flowNodeRef>F_Aufnehmen</bpmn:flowNodeRef><bpmn:flowNodeRef>F_Pruefen</bpmn:flowNodeRef><bpmn:flowNodeRef>F_Frage</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="F_Leihverkehr" name="Leihverkehr"><bpmn:flowNodeRef>F_Senden</bpmn:flowNodeRef><bpmn:flowNodeRef>F_Ende</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="F_Start" name="Titel fehlt"/>
    <bpmn:task id="F_Aufnehmen" name="Bestellung aufnehmen"/>
    <bpmn:task id="F_Pruefen" name="Angaben prüfen"/>
    <bpmn:exclusiveGateway id="F_Frage" name="Angaben vollständig?"/>
    <bpmn:sendTask id="F_Senden" name="An den Leihverkehr senden"/>
    <bpmn:manualTask id="F_Abholen" name="Buch abholen"/>
    <bpmn:endEvent id="F_Ende" name="Bestellt"/>
    <bpmn:sequenceFlow id="F1" sourceRef="F_Start" targetRef="F_Aufnehmen"/>
    <bpmn:sequenceFlow id="F2" sourceRef="F_Aufnehmen" targetRef="F_Pruefen"/>
    <bpmn:sequenceFlow id="F3" sourceRef="F_Pruefen" targetRef="F_Frage"/>
    <bpmn:sequenceFlow id="F4" sourceRef="F_Frage" targetRef="F_Aufnehmen" name="nein"/>
    <bpmn:sequenceFlow id="F5" sourceRef="F_Frage" targetRef="F_Senden" name="ja"/>
    <bpmn:sequenceFlow id="F6" sourceRef="F_Senden" targetRef="F_Abholen"/>
    <bpmn:sequenceFlow id="F7" sourceRef="F_Abholen" targetRef="F_Ende"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="dokufix_diagram">
    <bpmndi:BPMNPlane id="dokufix_plane" bpmnElement="Zusammenarbeit">
      <bpmndi:BPMNShape id="Fernleihe_di" bpmnElement="Fernleihe" isHorizontal="true"><dc:Bounds x="-133" y="-132" width="776" height="435"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Leserin_di" bpmnElement="F_Leserin" isHorizontal="true"><dc:Bounds x="-103" y="-132" width="746" height="146"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Theke_di" bpmnElement="F_Theke" isHorizontal="true"><dc:Bounds x="-103" y="14" width="746" height="143"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Leihverkehr_di" bpmnElement="F_Leihverkehr" isHorizontal="true"><dc:Bounds x="-103" y="157" width="746" height="146"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Start_di" bpmnElement="F_Start"><dc:Bounds x="-15" y="-74" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="-42" y="-93" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Aufnehmen_di" bpmnElement="F_Aufnehmen"><dc:Bounds x="-57" y="47" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Pruefen_di" bpmnElement="F_Pruefen"><dc:Bounds x="102" y="47" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Frage_di" bpmnElement="F_Frage" isMarkerVisible="true"><dc:Bounds x="263" y="62" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="313" y="72" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Senden_di" bpmnElement="F_Senden"><dc:Bounds x="371" y="187" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Abholen_di" bpmnElement="F_Abholen"><dc:Bounds x="371" y="-96" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Ende_di" bpmnElement="F_Ende"><dc:Bounds x="573" y="209" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="546" y="249" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="3" y="-38"/><di:waypoint x="3" y="47"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="63" y="87"/><di:waypoint x="102" y="87"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="222" y="87"/><di:waypoint x="263" y="87"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="288" y="62"/><di:waypoint x="288" y="27"/><di:waypoint x="43" y="27"/><di:waypoint x="43" y="47"/><bpmndi:BPMNLabel><dc:Bounds x="251" y="31" width="26" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="288" y="112"/><di:waypoint x="288" y="227"/><di:waypoint x="371" y="227"/><bpmndi:BPMNLabel><dc:Bounds x="294" y="120" width="13" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="431" y="187"/><di:waypoint x="431" y="-16"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="491" y="-56"/><di:waypoint x="591" y="-56"/><di:waypoint x="591" y="209"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
