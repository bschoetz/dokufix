<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_Werkstatt"
                  targetNamespace="http://example.org/bpmn/werkstatt">
  <bpmn:message id="Msg_Auftrag" name="Reparaturauftrag" />
  <bpmn:message id="Msg_KV" name="Kostenvoranschlag" />
  <bpmn:message id="Msg_Freigabe" name="Freigabe" />
  <bpmn:message id="Msg_Bestellung" name="Ersatzteilbestellung" />
  <bpmn:message id="Msg_Lieferung" name="Ersatzteillieferung" />
  <bpmn:message id="Msg_Fertig" name="Fertigmeldung" />

  <bpmn:collaboration id="Collaboration_Werkstatt">
    <bpmn:participant id="Participant_Kunde" name="Kunde" />
    <bpmn:participant id="Participant_Werkstatt" name="Kfz-Werkstatt" processRef="Process_Werkstatt" />
    <bpmn:participant id="Participant_Grosshaendler" name="Großhändler" />
    <bpmn:messageFlow id="MF_Auftrag" name="Reparaturauftrag" sourceRef="Participant_Kunde" targetRef="Start_Auftrag" messageRef="Msg_Auftrag" />
    <bpmn:messageFlow id="MF_KV" name="Kostenvoranschlag" sourceRef="Task_KVSenden" targetRef="Participant_Kunde" messageRef="Msg_KV" />
    <bpmn:messageFlow id="MF_Freigabe" name="Freigabe" sourceRef="Participant_Kunde" targetRef="Event_Freigabe" messageRef="Msg_Freigabe" />
    <bpmn:messageFlow id="MF_Bestellung" name="Bestellung" sourceRef="Task_Bestellen" targetRef="Participant_Grosshaendler" messageRef="Msg_Bestellung" />
    <bpmn:messageFlow id="MF_Lieferung" name="Lieferung" sourceRef="Participant_Grosshaendler" targetRef="Event_Lieferung" messageRef="Msg_Lieferung" />
    <bpmn:messageFlow id="MF_Fertig" name="Fertigmeldung" sourceRef="Task_Melden" targetRef="Participant_Kunde" messageRef="Msg_Fertig" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Werkstatt" name="Reparatur durchführen" isExecutable="false">
    <bpmn:startEvent id="Start_Auftrag" name="Reparaturauftrag eingegangen">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Auftrag" messageRef="Msg_Auftrag" />
    </bpmn:startEvent>
    <bpmn:task id="Task_Annehmen" name="Reparaturauftrag annehmen">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_KVErstellen" name="Kostenvoranschlag erstellen">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_KVSenden" name="Kostenvoranschlag an Kunden senden" messageRef="Msg_KV">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_Freigabe" name="Freigabe erhalten">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Freigabe" messageRef="Msg_Freigabe" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Teile" name="Ersatzteile vorrätig?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Ja</bpmn:outgoing>
      <bpmn:outgoing>Flow_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Bestellen" name="Fehlende Ersatzteile bestellen" messageRef="Msg_Bestellung">
      <bpmn:incoming>Flow_Nein</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_Lieferung" name="Ersatzteile geliefert">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Lieferung" messageRef="Msg_Lieferung" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Join">
      <bpmn:incoming>Flow_Ja</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reparieren" name="Auto reparieren">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_Melden" name="Fertigstellung an Kunden melden" messageRef="Msg_Fertig">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Fertig" name="Reparatur abgeschlossen">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Auftrag" targetRef="Task_Annehmen" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Annehmen" targetRef="Task_KVErstellen" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_KVErstellen" targetRef="Task_KVSenden" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_KVSenden" targetRef="Event_Freigabe" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Event_Freigabe" targetRef="Gateway_Teile" />
    <bpmn:sequenceFlow id="Flow_Ja" name="ja" sourceRef="Gateway_Teile" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Nein" name="nein" sourceRef="Gateway_Teile" targetRef="Task_Bestellen" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Bestellen" targetRef="Event_Lieferung" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Event_Lieferung" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_Join" targetRef="Task_Reparieren" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Reparieren" targetRef="Task_Melden" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Melden" targetRef="End_Fertig" />
  </bpmn:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="dokufix_diagram">
    <bpmndi:BPMNPlane id="dokufix_plane" bpmnElement="Collaboration_Werkstatt">
      <bpmndi:BPMNShape id="Participant_Kunde_di" bpmnElement="Participant_Kunde" isHorizontal="true"><dc:Bounds x="0" y="0" width="1810" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Werkstatt_di" bpmnElement="Participant_Werkstatt" isHorizontal="true"><dc:Bounds x="0" y="100" width="1810" height="144"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Grosshaendler_di" bpmnElement="Participant_Grosshaendler" isHorizontal="true"><dc:Bounds x="0" y="284" width="1810" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Auftrag_di" bpmnElement="Start_Auftrag"><dc:Bounds x="102" y="154" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="75" y="194" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Annehmen_di" bpmnElement="Task_Annehmen"><dc:Bounds x="210" y="132" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KVErstellen_di" bpmnElement="Task_KVErstellen"><dc:Bounds x="378" y="132" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KVSenden_di" bpmnElement="Task_KVSenden"><dc:Bounds x="546" y="132" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Freigabe_di" bpmnElement="Event_Freigabe"><dc:Bounds x="738" y="154" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="711" y="194" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Teile_di" bpmnElement="Gateway_Teile" isMarkerVisible="true"><dc:Bounds x="846" y="147" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="826" y="201" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Bestellen_di" bpmnElement="Task_Bestellen"><dc:Bounds x="944" y="132" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Lieferung_di" bpmnElement="Event_Lieferung"><dc:Bounds x="1136" y="154" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1165" y="192" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Join_di" bpmnElement="Gateway_Join" isMarkerVisible="true"><dc:Bounds x="1244" y="147" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reparieren_di" bpmnElement="Task_Reparieren"><dc:Bounds x="1342" y="132" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Melden_di" bpmnElement="Task_Melden"><dc:Bounds x="1510" y="132" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Fertig_di" bpmnElement="End_Fertig"><dc:Bounds x="1702" y="154" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1675" y="194" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="138" y="172"/><di:waypoint x="210" y="172"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="330" y="172"/><di:waypoint x="378" y="172"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="498" y="172"/><di:waypoint x="546" y="172"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="666" y="172"/><di:waypoint x="738" y="172"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="774" y="172"/><di:waypoint x="846" y="172"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ja_di" bpmnElement="Flow_Ja"><di:waypoint x="871" y="147"/><di:waypoint x="871" y="120"/><di:waypoint x="1269" y="120"/><di:waypoint x="1269" y="147"/><bpmndi:BPMNLabel><dc:Bounds x="877" y="124" width="13" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Nein_di" bpmnElement="Flow_Nein"><di:waypoint x="896" y="172"/><di:waypoint x="944" y="172"/><bpmndi:BPMNLabel><dc:Bounds x="906" y="153" width="26" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1064" y="172"/><di:waypoint x="1136" y="172"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1172" y="172"/><di:waypoint x="1244" y="172"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1294" y="172"/><di:waypoint x="1342" y="172"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1462" y="172"/><di:waypoint x="1510" y="172"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1630" y="172"/><di:waypoint x="1702" y="172"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Auftrag_di" bpmnElement="MF_Auftrag"><di:waypoint x="120" y="60"/><di:waypoint x="120" y="154"/><bpmndi:BPMNLabel><dc:Bounds x="126" y="72.5" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_KV_di" bpmnElement="MF_KV"><di:waypoint x="606" y="132"/><di:waypoint x="606" y="60"/><bpmndi:BPMNLabel><dc:Bounds x="612" y="72.5" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Freigabe_di" bpmnElement="MF_Freigabe"><di:waypoint x="756" y="60"/><di:waypoint x="756" y="154"/><bpmndi:BPMNLabel><dc:Bounds x="762" y="72.5" width="52.8" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Bestellung_di" bpmnElement="MF_Bestellung"><di:waypoint x="1004" y="212"/><di:waypoint x="1004" y="284"/><bpmndi:BPMNLabel><dc:Bounds x="1010" y="256.5" width="66" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Lieferung_di" bpmnElement="MF_Lieferung"><di:waypoint x="1154" y="284"/><di:waypoint x="1154" y="190"/><bpmndi:BPMNLabel><dc:Bounds x="1160" y="256.5" width="59.4" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Fertig_di" bpmnElement="MF_Fertig"><di:waypoint x="1570" y="132"/><di:waypoint x="1570" y="60"/><bpmndi:BPMNLabel><dc:Bounds x="1576" y="72.5" width="85.8" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
