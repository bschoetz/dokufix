<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_Kredit"
                  targetNamespace="http://example.org/bpmn/kredit">
  <bpmn:message id="Msg_Antrag" name="Kreditantrag" />
  <bpmn:message id="Msg_Anfrage" name="Bonitätsanfrage" />
  <bpmn:message id="Msg_Auskunft" name="Bonitätsauskunft" />
  <bpmn:message id="Msg_Zusage" name="Zusage mit Vertrag" />
  <bpmn:message id="Msg_Absage" name="Absage" />

  <bpmn:collaboration id="Collaboration_Kredit">
    <bpmn:participant id="Participant_Kunde" name="Kunde" />
    <bpmn:participant id="Participant_Bank" name="Bank" processRef="Process_Bank" />
    <bpmn:participant id="Participant_Auskunftei" name="Auskunftei" />
    <bpmn:messageFlow id="Flow_Msg_Antrag" name="Kreditantrag" sourceRef="Participant_Kunde" targetRef="Start_Antrag" messageRef="Msg_Antrag" />
    <bpmn:messageFlow id="Flow_Msg_Anfrage" name="Bonitätsanfrage" sourceRef="Task_BonitaetAnfragen" targetRef="Participant_Auskunftei" messageRef="Msg_Anfrage" />
    <bpmn:messageFlow id="Flow_Msg_Auskunft" name="Bonitätsauskunft" sourceRef="Participant_Auskunftei" targetRef="Task_AuskunftEmpfangen" messageRef="Msg_Auskunft" />
    <bpmn:messageFlow id="Flow_Msg_Zusage" name="Zusage mit Vertrag" sourceRef="Task_ZusageSenden" targetRef="Participant_Kunde" messageRef="Msg_Zusage" />
    <bpmn:messageFlow id="Flow_Msg_Absage" name="Absage" sourceRef="Task_AbsageSenden" targetRef="Participant_Kunde" messageRef="Msg_Absage" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Bank" name="Kreditantrag bearbeiten" isExecutable="false">
    <bpmn:startEvent id="Start_Antrag" name="Kreditantrag eingegangen">
      <bpmn:outgoing>SF_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Antrag" messageRef="Msg_Antrag" />
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_BonitaetAnfragen" name="Bonität anfragen" messageRef="Msg_Anfrage">
      <bpmn:incoming>SF_1</bpmn:incoming>
      <bpmn:outgoing>SF_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_AuskunftEmpfangen" name="Bonitätsauskunft empfangen" messageRef="Msg_Auskunft">
      <bpmn:incoming>SF_2</bpmn:incoming>
      <bpmn:outgoing>SF_3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Task_Entscheiden" name="Über Kreditantrag entscheiden">
      <bpmn:incoming>SF_3</bpmn:incoming>
      <bpmn:outgoing>SF_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Entscheidung" name="Kredit bewilligt?">
      <bpmn:incoming>SF_4</bpmn:incoming>
      <bpmn:outgoing>SF_Ja</bpmn:outgoing>
      <bpmn:outgoing>SF_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_ZusageSenden" name="Zusage mit Vertrag senden" messageRef="Msg_Zusage">
      <bpmn:incoming>SF_Ja</bpmn:incoming>
      <bpmn:outgoing>SF_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_AbsageSenden" name="Absage senden" messageRef="Msg_Absage">
      <bpmn:incoming>SF_Nein</bpmn:incoming>
      <bpmn:outgoing>SF_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Zusage" name="Kredit zugesagt">
      <bpmn:incoming>SF_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Absage" name="Kredit abgelehnt">
      <bpmn:incoming>SF_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_1" sourceRef="Start_Antrag" targetRef="Task_BonitaetAnfragen" />
    <bpmn:sequenceFlow id="SF_2" sourceRef="Task_BonitaetAnfragen" targetRef="Task_AuskunftEmpfangen" />
    <bpmn:sequenceFlow id="SF_3" sourceRef="Task_AuskunftEmpfangen" targetRef="Task_Entscheiden" />
    <bpmn:sequenceFlow id="SF_4" sourceRef="Task_Entscheiden" targetRef="Gateway_Entscheidung" />
    <bpmn:sequenceFlow id="SF_Ja" name="ja" sourceRef="Gateway_Entscheidung" targetRef="Task_ZusageSenden" />
    <bpmn:sequenceFlow id="SF_Nein" name="nein" sourceRef="Gateway_Entscheidung" targetRef="Task_AbsageSenden" />
    <bpmn:sequenceFlow id="SF_5" sourceRef="Task_ZusageSenden" targetRef="End_Zusage" />
    <bpmn:sequenceFlow id="SF_6" sourceRef="Task_AbsageSenden" targetRef="End_Absage" />
  </bpmn:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="dokufix_diagram">
    <bpmndi:BPMNPlane id="dokufix_plane" bpmnElement="Collaboration_Kredit">
      <bpmndi:BPMNShape id="Participant_Kunde_di" bpmnElement="Participant_Kunde" isHorizontal="true"><dc:Bounds x="0" y="0" width="1182" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Bank_di" bpmnElement="Participant_Bank" isHorizontal="true"><dc:Bounds x="0" y="101" width="1182" height="268"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Auskunftei_di" bpmnElement="Participant_Auskunftei" isHorizontal="true"><dc:Bounds x="0" y="409" width="1182" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Antrag_di" bpmnElement="Start_Antrag"><dc:Bounds x="102" y="155" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="75" y="195" width="90" height="29"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BonitaetAnfragen_di" bpmnElement="Task_BonitaetAnfragen"><dc:Bounds x="210" y="133" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AuskunftEmpfangen_di" bpmnElement="Task_AuskunftEmpfangen"><dc:Bounds x="378" y="133" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Entscheiden_di" bpmnElement="Task_Entscheiden"><dc:Bounds x="546" y="133" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Entscheidung_di" bpmnElement="Gateway_Entscheidung" isMarkerVisible="true"><dc:Bounds x="749" y="148" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="729" y="129" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ZusageSenden_di" bpmnElement="Task_ZusageSenden"><dc:Bounds x="882" y="133" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AbsageSenden_di" bpmnElement="Task_AbsageSenden"><dc:Bounds x="714" y="257" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Zusage_di" bpmnElement="End_Zusage"><dc:Bounds x="1074" y="155" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1047" y="195" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Absage_di" bpmnElement="End_Absage"><dc:Bounds x="1074" y="279" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1047" y="319" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SF_1_di" bpmnElement="SF_1"><di:waypoint x="138" y="173"/><di:waypoint x="210" y="173"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_2_di" bpmnElement="SF_2"><di:waypoint x="330" y="173"/><di:waypoint x="378" y="173"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_3_di" bpmnElement="SF_3"><di:waypoint x="498" y="173"/><di:waypoint x="546" y="173"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_4_di" bpmnElement="SF_4"><di:waypoint x="666" y="173"/><di:waypoint x="749" y="173"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_Ja_di" bpmnElement="SF_Ja"><di:waypoint x="799" y="173"/><di:waypoint x="882" y="173"/><bpmndi:BPMNLabel><dc:Bounds x="809" y="154" width="10" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_Nein_di" bpmnElement="SF_Nein"><di:waypoint x="774" y="198"/><di:waypoint x="774" y="257"/><bpmndi:BPMNLabel><dc:Bounds x="780" y="206" width="23" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_5_di" bpmnElement="SF_5"><di:waypoint x="1002" y="173"/><di:waypoint x="1074" y="173"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SF_6_di" bpmnElement="SF_6"><di:waypoint x="834" y="297"/><di:waypoint x="1074" y="297"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Msg_Antrag_di" bpmnElement="Flow_Msg_Antrag"><di:waypoint x="120" y="60"/><di:waypoint x="120" y="155"/><bpmndi:BPMNLabel><dc:Bounds x="126" y="73" width="66" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Msg_Anfrage_di" bpmnElement="Flow_Msg_Anfrage"><di:waypoint x="270" y="213"/><di:waypoint x="270" y="409"/><bpmndi:BPMNLabel><dc:Bounds x="276" y="381.5" width="85" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Msg_Auskunft_di" bpmnElement="Flow_Msg_Auskunft"><di:waypoint x="438" y="409"/><di:waypoint x="438" y="213"/><bpmndi:BPMNLabel><dc:Bounds x="444" y="381.5" width="89" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Msg_Zusage_di" bpmnElement="Flow_Msg_Zusage"><di:waypoint x="942" y="133"/><di:waypoint x="942" y="60"/><bpmndi:BPMNLabel><dc:Bounds x="948" y="66" width="60" height="29"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Msg_Absage_di" bpmnElement="Flow_Msg_Absage"><di:waypoint x="744" y="257"/><di:waypoint x="744" y="241"/><di:waypoint x="702" y="241"/><di:waypoint x="702" y="60"/><bpmndi:BPMNLabel><dc:Bounds x="708" y="73" width="41" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
