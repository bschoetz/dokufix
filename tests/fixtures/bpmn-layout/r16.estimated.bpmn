<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="D" targetNamespace="http://example.org/r">
  <bpmn:collaboration id="C"><bpmn:participant id="P" name="Pool" processRef="Proc"/></bpmn:collaboration>
  <bpmn:process id="Proc" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="Lane_1" name="Up"><bpmn:flowNodeRef>u1</bpmn:flowNodeRef><bpmn:flowNodeRef>u2</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_2" name="Row"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>p1</bpmn:flowNodeRef><bpmn:flowNodeRef>x</bpmn:flowNodeRef><bpmn:flowNodeRef>y</bpmn:flowNodeRef><bpmn:flowNodeRef>p2</bpmn:flowNodeRef><bpmn:flowNodeRef>q</bpmn:flowNodeRef><bpmn:flowNodeRef>z</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s"/>
    <bpmn:parallelGateway id="p1"/>
    <bpmn:task id="x" name="X"/>
    <bpmn:task id="y" name="Y"/>
    <bpmn:parallelGateway id="p2"/>
    <bpmn:exclusiveGateway id="q" name="nochmal?"/>
    <bpmn:endEvent id="z"/>
    <bpmn:task id="u1" name="Parallel oben"/>
    <bpmn:task id="u2" name="Melden"/>
    <bpmn:sequenceFlow id="F1_s_p1" sourceRef="s" targetRef="p1"/>
    <bpmn:sequenceFlow id="F2_p1_x" sourceRef="p1" targetRef="x"/>
