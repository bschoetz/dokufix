    <bpmn:sequenceFlow id="F8_q_z" sourceRef="q" targetRef="z" name="nein"/>
    <bpmn:sequenceFlow id="F9_q_u2" sourceRef="q" targetRef="u2" name="melden"/>
    <bpmn:sequenceFlow id="F10_p1_u1" sourceRef="p1" targetRef="u1"/>
    <bpmn:sequenceFlow id="F11_u1_p2" sourceRef="u1" targetRef="p2"/>
