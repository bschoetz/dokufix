<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="D" targetNamespace="http://example.org/d">
  <bpmn:process id="P" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="L1" name="Annahme"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L2" name="Technik"><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L3" name="Kasse"><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>e</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Fahrrad gebracht"/>
    <bpmn:task id="t1" name="Auftrag anlegen">
      <bpmn:dataOutputAssociation id="o1"><bpmn:targetRef>d1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t2" name="Schaden prüfen">
      <bpmn:property id="p2" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="i2"><bpmn:sourceRef>d1</bpmn:sourceRef><bpmn:targetRef>p2</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="t3" name="Reparieren">
      <bpmn:dataOutputAssociation id="o3"><bpmn:targetRef>d2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="t4" name="Rechnung stellen">
      <bpmn:property id="p4" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="i4a"><bpmn:sourceRef>d1</bpmn:sourceRef><bpmn:targetRef>p4</bpmn:targetRef></bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="i4b"><bpmn:sourceRef>d2</bpmn:sourceRef><bpmn:targetRef>p4</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="e" name="Fahrrad abgeholt"/>
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="t3"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t4" targetRef="e"/>
    <bpmn:dataObject id="do1"/>
    <bpmn:dataObjectReference id="d1" name="Auftrag" dataObjectRef="do1"/>
    <bpmn:dataObject id="do2"/>
    <bpmn:dataObjectReference id="d2" name="Prüfbericht" dataObjectRef="do2"/>
  </bpmn:process>
</bpmn:definitions>
