<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitionen_Daten_Sonder" targetNamespace="http://example.org/dokufix">
  <bpmn:process id="DS_Prozess" isExecutable="false">
    <bpmn:startEvent id="DS_Start" name="Auftrag da"/>
    <bpmn:task id="DS_Lesen" name="Auftrag lesen">
      <bpmn:property id="DS_Notiz" name="Notiz"/>
      <bpmn:dataInputAssociation id="DS_Aus_Property"><bpmn:sourceRef>DS_Notiz</bpmn:sourceRef><bpmn:targetRef>DS_Notiz</bpmn:targetRef></bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DS_Ohne_Ziel"/>
    </bpmn:task>
    <bpmn:subProcess id="DS_Ausfuehren" name="Auftrag ausführen">
      <bpmn:dataOutputAssociation id="DS_Schreibt_Abnahme"><bpmn:targetRef>DS_Abnahme</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:startEvent id="DS_Innen_Start"/>
      <bpmn:task id="DS_Innen_Arbeiten" name="Arbeiten">
        <bpmn:dataOutputAssociation id="DS_Innen_Schreibt"><bpmn:targetRef>DS_Zettel</bpmn:targetRef></bpmn:dataOutputAssociation>
      </bpmn:task>
      <bpmn:endEvent id="DS_Innen_Ende"/>
      <bpmn:sequenceFlow id="DS_Innen_F1" sourceRef="DS_Innen_Start" targetRef="DS_Innen_Arbeiten"/>
      <bpmn:sequenceFlow id="DS_Innen_F2" sourceRef="DS_Innen_Arbeiten" targetRef="DS_Innen_Ende"/>
      <bpmn:dataObject id="DS_Zettel_Objekt"/>
      <bpmn:dataObjectReference id="DS_Zettel" name="Arbeitszettel" dataObjectRef="DS_Zettel_Objekt"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="DS_Ende" name="Erledigt"/>
    <bpmn:sequenceFlow id="DS_F1" sourceRef="DS_Start" targetRef="DS_Lesen"/>
    <bpmn:sequenceFlow id="DS_F2" sourceRef="DS_Lesen" targetRef="DS_Ausfuehren"/>
    <bpmn:sequenceFlow id="DS_F3" sourceRef="DS_Ausfuehren" targetRef="DS_Ende"/>
    <bpmn:dataObject id="DS_Abnahme_Objekt"/>
    <bpmn:dataObjectReference id="DS_Abnahme" name="Abnahmeprotokoll" dataObjectRef="DS_Abnahme_Objekt"/>
    <bpmn:dataStoreReference id="DS_Archiv" name="Archiv"/>
    <bpmn:dataObject id="DS_Allein"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="dokufix_diagram">
    <bpmndi:BPMNPlane id="dokufix_plane" bpmnElement="DS_Prozess">
      <bpmndi:BPMNShape id="DS_Start_di" bpmnElement="DS_Start"><dc:Bounds x="102" y="144" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="75" y="184" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Lesen_di" bpmnElement="DS_Lesen"><dc:Bounds x="210" y="122" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Ausfuehren_di" bpmnElement="DS_Ausfuehren"><dc:Bounds x="378" y="122" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Ende_di" bpmnElement="DS_Ende"><dc:Bounds x="570" y="144" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="543" y="184" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Abnahme_di" bpmnElement="DS_Abnahme"><dc:Bounds x="420" y="12" width="36" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="393" y="-6" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Archiv_di" bpmnElement="DS_Archiv"><dc:Bounds x="42" y="12" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="23" y="66" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DS_F1_di" bpmnElement="DS_F1"><di:waypoint x="138" y="162"/><di:waypoint x="210" y="162"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DS_F2_di" bpmnElement="DS_F2"><di:waypoint x="330" y="162"/><di:waypoint x="378" y="162"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DS_F3_di" bpmnElement="DS_F3"><di:waypoint x="498" y="162"/><di:waypoint x="570" y="162"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DS_Schreibt_Abnahme_di" bpmnElement="DS_Schreibt_Abnahme"><di:waypoint x="438" y="122"/><di:waypoint x="438" y="62"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
