<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="D" targetNamespace="http://example.org/r">
  <bpmn:collaboration id="C"><bpmn:participant id="P" name="Pool" processRef="Proc"/></bpmn:collaboration>
  <bpmn:process id="Proc" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="Lane_1" name="Oben"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>a</bpmn:flowNodeRef><bpmn:flowNodeRef>b</bpmn:flowNodeRef><bpmn:flowNodeRef>g</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_2" name="Unten"><bpmn:flowNodeRef>c</bpmn:flowNodeRef><bpmn:flowNodeRef>d</bpmn:flowNodeRef><bpmn:flowNodeRef>z</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s"/>
    <bpmn:task id="a" name="Erstellen"/>
    <bpmn:task id="b" name="Prüfen"/>
    <bpmn:exclusiveGateway id="g" name="gut?"/>
    <bpmn:task id="c" name="Verteilen"/>
    <bpmn:task id="d" name="Archivieren"/>
    <bpmn:endEvent id="z"/>
    <bpmn:sequenceFlow id="F1_s_a" sourceRef="s" targetRef="a"/>
    <bpmn:sequenceFlow id="F2_a_b" sourceRef="a" targetRef="b"/>
    <bpmn:sequenceFlow id="F3_b_g" sourceRef="b" targetRef="g"/>
    <bpmn:sequenceFlow id="F4_g_a" sourceRef="g" targetRef="a" name="nein"/>
    <bpmn:sequenceFlow id="F5_g_b" sourceRef="g" targetRef="b" name="fast"/>
    <bpmn:sequenceFlow id="F6_g_c" sourceRef="g" targetRef="c" name="ja"/>
    <bpmn:sequenceFlow id="F7_a_c" sourceRef="a" targetRef="c" name="Eilfall"/>
    <bpmn:sequenceFlow id="F8_c_d" sourceRef="c" targetRef="d"/>
    <bpmn:sequenceFlow id="F9_d_z" sourceRef="d" targetRef="z"/>
  </bpmn:process>
</bpmn:definitions>
