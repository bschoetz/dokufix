    <bpmn:sequenceFlow id="F12_gb_c1" sourceRef="gb" targetRef="c1" name="ok"/>
    <bpmn:sequenceFlow id="F13_c1_c2" sourceRef="c1" targetRef="c2"/>
    <bpmn:sequenceFlow id="F14_c2_z" sourceRef="c2" targetRef="z"/>
