    <bpmn:task id="c1" name="c1"/>
    <bpmn:task id="c2" name="c2"/>
    <bpmn:endEvent id="z"/>
    <bpmn:sequenceFlow id="F1_s_a1" sourceRef="s" targetRef="a1"/>
