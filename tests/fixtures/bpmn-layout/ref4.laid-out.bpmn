<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitionen" targetNamespace="http://example.org/dokufix">
  <bpmn:process id="Prozess" isExecutable="false">
    <bpmn:startEvent id="Los" name="Medium zurück"/>
    <bpmn:task id="Aufgabe" name="Etikett scannen"/>
    <bpmn:intermediateCatchEvent id="Warten" name="Zwei Tage"><bpmn:timerEventDefinition id="Warten_Def"/></bpmn:intermediateCatchEvent>
    <bpmn:task id="Regal" name="Zurück ins Regal"/>
    <bpmn:endEvent id="Fertig" name="Wieder ausleihbar"/>
    <bpmn:sequenceFlow id="O1" sourceRef="Los" targetRef="Aufgabe"/>
    <bpmn:sequenceFlow id="O2" sourceRef="Aufgabe" targetRef="Warten"/>
    <bpmn:sequenceFlow id="O3" sourceRef="Warten" targetRef="Regal"/>
    <bpmn:sequenceFlow id="O4" sourceRef="Regal" targetRef="Fertig"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="dokufix_diagram">
    <bpmndi:BPMNPlane id="dokufix_plane" bpmnElement="Prozess">
      <bpmndi:BPMNShape id="Los_di" bpmnElement="Los"><dc:Bounds x="102" y="54" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="75" y="94" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Aufgabe_di" bpmnElement="Aufgabe"><dc:Bounds x="210" y="32" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Warten_di" bpmnElement="Warten"><dc:Bounds x="402" y="54" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="375" y="94" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Regal_di" bpmnElement="Regal"><dc:Bounds x="510" y="32" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fertig_di" bpmnElement="Fertig"><dc:Bounds x="702" y="54" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="675" y="94" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="O1_di" bpmnElement="O1"><di:waypoint x="138" y="72"/><di:waypoint x="210" y="72"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="O2_di" bpmnElement="O2"><di:waypoint x="330" y="72"/><di:waypoint x="402" y="72"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="O3_di" bpmnElement="O3"><di:waypoint x="438" y="72"/><di:waypoint x="510" y="72"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="O4_di" bpmnElement="O4"><di:waypoint x="630" y="72"/><di:waypoint x="702" y="72"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
