<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_Hundemelken"
                  targetNamespace="http://example.com/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Melkbetrieb" name="Hundemelkbetrieb" processRef="Process_Hundemelken" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Hundemelken" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Melker" name="Melker">
        <bpmn:flowNodeRef>Start_Melkzeit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rufen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reinigen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Ruhig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Beruhigen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Melken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Alle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Belohnen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Huendin" name="Hündin">
        <bpmn:flowNodeRef>Task_Kommen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Abgeben</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Verarbeitung" name="Verarbeitung">
        <bpmn:flowNodeRef>Task_Filtern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Kuehlen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dokumentieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Fertig</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Lane Melker -->
    <bpmn:startEvent id="Start_Melkzeit" name="Melkzeit erreicht">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Rufen" name="Hündin zum Melkstand rufen">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Reinigen" name="Zitzen reinigen &amp; Euter massieren">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Ruhig" name="Hündin ruhig?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Beruhigen" name="Beruhigen &amp; Leckerli geben">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Melken" name="Eine Zitze von Hand melken">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Alle" name="Alle Zitzen gemolken?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Belohnen" name="Hündin belohnen &amp; entlassen">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>

    <!-- Lane Hündin -->
    <bpmn:task id="Task_Kommen" name="Zum Melkstand kommen &amp; ablegen">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Abgeben" name="Stillhalten &amp; Milch abgeben">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>

    <!-- Lane Verarbeitung -->
    <bpmn:task id="Task_Filtern" name="Milch filtern">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Kuehlen" name="Auf 4 °C kühlen">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Dokumentieren" name="Menge wiegen &amp; dokumentieren">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Fertig" name="Milch eingelagert">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequenzflüsse -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Melkzeit" targetRef="Task_Rufen" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Rufen" targetRef="Task_Kommen" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Kommen" targetRef="Task_Reinigen" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Reinigen" targetRef="GW_Ruhig" />
    <bpmn:sequenceFlow id="Flow_5" name="ja" sourceRef="GW_Ruhig" targetRef="Task_Melken" />
    <bpmn:sequenceFlow id="Flow_6" name="nein" sourceRef="GW_Ruhig" targetRef="Task_Beruhigen" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Beruhigen" targetRef="Task_Reinigen" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Melken" targetRef="Task_Abgeben" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Abgeben" targetRef="GW_Alle" />
    <bpmn:sequenceFlow id="Flow_10" name="nein" sourceRef="GW_Alle" targetRef="Task_Melken" />
    <bpmn:sequenceFlow id="Flow_11" name="ja" sourceRef="GW_Alle" targetRef="Task_Belohnen" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Belohnen" targetRef="Task_Filtern" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Filtern" targetRef="Task_Kuehlen" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Kuehlen" targetRef="Task_Dokumentieren" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Dokumentieren" targetRef="End_Fertig" />
  </bpmn:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="dokufix_diagram">
    <bpmndi:BPMNPlane id="dokufix_plane" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Melkbetrieb_di" bpmnElement="Participant_Melkbetrieb" isHorizontal="true"><dc:Bounds x="-137" y="-135" width="1770" height="452"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Melker_di" bpmnElement="Lane_Melker" isHorizontal="true"><dc:Bounds x="-107" y="-135" width="1740" height="151"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Huendin_di" bpmnElement="Lane_Huendin" isHorizontal="true"><dc:Bounds x="-107" y="16" width="1740" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Verarbeitung_di" bpmnElement="Lane_Verarbeitung" isHorizontal="true"><dc:Bounds x="-107" y="166" width="1740" height="151"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Melkzeit_di" bpmnElement="Start_Melkzeit"><dc:Bounds x="-37" y="-77" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="-64" y="-37" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Rufen_di" bpmnElement="Task_Rufen"><dc:Bounds x="93" y="-99" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reinigen_di" bpmnElement="Task_Reinigen"><dc:Bounds x="259" y="-99" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Ruhig_di" bpmnElement="GW_Ruhig" isMarkerVisible="true"><dc:Bounds x="438" y="-84" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="418" y="-30" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Beruhigen_di" bpmnElement="Task_Beruhigen"><dc:Bounds x="558" y="-99" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Melken_di" bpmnElement="Task_Melken"><dc:Bounds x="724" y="-99" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Alle_di" bpmnElement="GW_Alle" isMarkerVisible="true"><dc:Bounds x="906" y="-84" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="886" y="-30" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Belohnen_di" bpmnElement="Task_Belohnen"><dc:Bounds x="1026" y="-99" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Kommen_di" bpmnElement="Task_Kommen"><dc:Bounds x="93" y="51" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Abgeben_di" bpmnElement="Task_Abgeben"><dc:Bounds x="724" y="51" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Filtern_di" bpmnElement="Task_Filtern"><dc:Bounds x="1026" y="201" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Kuehlen_di" bpmnElement="Task_Kuehlen"><dc:Bounds x="1192" y="201" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Dokumentieren_di" bpmnElement="Task_Dokumentieren"><dc:Bounds x="1358" y="201" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Fertig_di" bpmnElement="End_Fertig"><dc:Bounds x="1563" y="223" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1536" y="263" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="-1" y="-59"/><di:waypoint x="93" y="-59"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="153" y="-19"/><di:waypoint x="153" y="51"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="213" y="91"/><di:waypoint x="229" y="91"/><di:waypoint x="229" y="-59"/><di:waypoint x="259" y="-59"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="379" y="-59"/><di:waypoint x="438" y="-59"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="463" y="-84"/><di:waypoint x="463" y="-111"/><di:waypoint x="784" y="-111"/><di:waypoint x="784" y="-99"/><bpmndi:BPMNLabel><dc:Bounds x="469" y="-107" width="13" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="488" y="-59"/><di:waypoint x="558" y="-59"/><bpmndi:BPMNLabel><dc:Bounds x="498" y="-78" width="26" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="618" y="-19"/><di:waypoint x="618" y="1"/><di:waypoint x="319" y="1"/><di:waypoint x="319" y="-19"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="784" y="-19"/><di:waypoint x="784" y="51"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="844" y="91"/><di:waypoint x="856" y="91"/><di:waypoint x="856" y="-59"/><di:waypoint x="906" y="-59"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="931" y="-84"/><di:waypoint x="931" y="-119"/><di:waypoint x="824" y="-119"/><di:waypoint x="824" y="-99"/><bpmndi:BPMNLabel><dc:Bounds x="937" y="-107" width="26" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="956" y="-59"/><di:waypoint x="1026" y="-59"/><bpmndi:BPMNLabel><dc:Bounds x="966" y="-78" width="13" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1086" y="-19"/><di:waypoint x="1086" y="201"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1146" y="241"/><di:waypoint x="1192" y="241"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1312" y="241"/><di:waypoint x="1358" y="241"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="1478" y="241"/><di:waypoint x="1563" y="241"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
