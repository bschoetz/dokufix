      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="378" y="122" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e"><dc:Bounds x="570" y="144" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="543" y="184" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d1_di" bpmnElement="d1"><dc:Bounds x="312" y="12" width="36" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="285" y="-6" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="w1_di" bpmnElement="w1"><dc:Bounds x="171" y="32" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="151" y="14" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="w2_di" bpmnElement="w2"><dc:Bounds x="245" y="32" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="225" y="14" width="90" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d2_di" bpmnElement="d2"><dc:Bounds x="312" y="246" width="36" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="331" y="258" width="90" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d3_di" bpmnElement="d3"><dc:Bounds x="456" y="266" width="36" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="429" y="320" width="90" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="138" y="162"/><di:waypoint x="210" y="162"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="270" y="202"/><di:waypoint x="270" y="356"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="330" y="396"/><di:waypoint x="438" y="396"/><di:waypoint x="438" y="202"/></bpmndi:BPMNEdge>
