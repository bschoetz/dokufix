      <bpmndi:BPMNEdge id="i3_di" bpmnElement="i3"><di:waypoint x="321" y="296"/><di:waypoint x="321" y="356"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="o3_di" bpmnElement="o3"><di:waypoint x="330" y="365"/><di:waypoint x="456" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="i2_di" bpmnElement="i2"><di:waypoint x="474" y="266"/><di:waypoint x="474" y="202"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
