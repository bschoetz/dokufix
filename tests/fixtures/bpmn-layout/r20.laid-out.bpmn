    <bpmn:sequenceFlow id="F3_u_g" sourceRef="u" targetRef="g"/>
    <bpmn:sequenceFlow id="F4_g_a" sourceRef="g" targetRef="a" name="zurück"/>
    <bpmn:sequenceFlow id="F5_g_c" sourceRef="g" targetRef="c" name="ja"/>
    <bpmn:sequenceFlow id="F6_g_d" sourceRef="g" targetRef="d" name="eskalieren"/>
    <bpmn:sequenceFlow id="F7_d_z" sourceRef="d" targetRef="z"/>
    <bpmn:sequenceFlow id="F8_c_z" sourceRef="c" targetRef="z"/>
