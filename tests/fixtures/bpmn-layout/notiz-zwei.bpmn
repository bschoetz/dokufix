<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="D" targetNamespace="http://example.org/n">
  <bpmn:process id="P" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="L1" name="Team"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>g</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>j</bpmn:flowNodeRef><bpmn:flowNodeRef>e</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L2" name="Leitung"><bpmn:flowNodeRef>t4</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Auftrag da"/>
    <bpmn:task id="t1" name="Auftrag prüfen"/>
    <bpmn:exclusiveGateway id="g" name="Eilig?"/>
    <bpmn:task id="t2" name="Sofort bearbeiten"/>
    <bpmn:task id="t3" name="Einplanen"><bpmn:standardLoopCharacteristics id="lc"/></bpmn:task>
    <bpmn:exclusiveGateway id="j"/>
    <bpmn:task id="t4" name="Ergebnis freigeben"/>
    <bpmn:endEvent id="e" name="Auftrag erledigt"/>
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="t1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="g"/>
    <bpmn:sequenceFlow id="f3" sourceRef="g" targetRef="t2" name="ja"/>
    <bpmn:sequenceFlow id="f4" sourceRef="g" targetRef="t3" name="nein"/>
    <bpmn:sequenceFlow id="f5" sourceRef="t2" targetRef="j"/>
    <bpmn:sequenceFlow id="f6" sourceRef="t3" targetRef="j"/>
    <bpmn:sequenceFlow id="f7" sourceRef="j" targetRef="t4"/>
    <bpmn:sequenceFlow id="f8" sourceRef="t4" targetRef="e"/>
    <bpmn:textAnnotation id="n1"><bpmn:text>Checkliste A verwenden</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a1" sourceRef="t1" targetRef="n1"/>
    <bpmn:textAnnotation id="n2"><bpmn:text>Bei Großkunden zusätzlich Vertrag prüfen</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a2" sourceRef="t1" targetRef="n2"/>
    <bpmn:textAnnotation id="n3"><bpmn:text>Eilig heißt: Frist kürzer als zwei Arbeitstage, oder die Geschäftsleitung hat den Auftrag ausdrücklich als dringend markiert. Im Zweifel bei der Leitung nachfragen und die Antwort im Ticket vermerken.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a3" sourceRef="n3" targetRef="g"/>
    <bpmn:textAnnotation id="n4"><bpmn:text>Wöchentlich wiederholen</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a4" sourceRef="t3" targetRef="n4"/>
    <bpmn:textAnnotation id="n5"><bpmn:text>Kunde per Mail informieren</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a5" sourceRef="e" targetRef="n5"/>
  </bpmn:process>
</bpmn:definitions>
