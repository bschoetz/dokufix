<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitionen_Angeheftet" targetNamespace="http://example.org/dokufix">
  <bpmn:process id="Prozess_Angeheftet" isExecutable="false">
    <bpmn:startEvent id="A_Start" name="Bestellung da"/>
    <bpmn:serviceTask id="A_Buchen" name="Sendung buchen"/>
    <bpmn:boundaryEvent id="A_Netz" name="Kein Netz" attachedToRef="A_Buchen"><bpmn:errorEventDefinition id="A_Netz_D"/></bpmn:boundaryEvent>
    <bpmn:task id="A_Liefern" name="Ware liefern"/>
    <bpmn:boundaryEvent id="A_Frist" name="Drei Tage" attachedToRef="A_Liefern"><bpmn:timerEventDefinition id="A_Frist_D"/></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="A_Frage" name="Rückfrage" cancelActivity="false" attachedToRef="A_Liefern"><bpmn:escalationEventDefinition id="A_Frage_D"/></bpmn:boundaryEvent>
    <bpmn:subProcess id="A_Pruefen" name="Lieferung prüfen">
      <bpmn:startEvent id="A_P_Start"/>
      <bpmn:endEvent id="A_P_Ende"/>
      <bpmn:sequenceFlow id="A_P1" sourceRef="A_P_Start" targetRef="A_P_Ende"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="A_Schaden" name="Schaden" attachedToRef="A_Pruefen"><bpmn:errorEventDefinition id="A_Schaden_D"/></bpmn:boundaryEvent>
    <bpmn:task id="A_Rechnung" name="Rechnung stellen"/>
    <bpmn:endEvent id="A_Ende" name="Geliefert"/>
    <bpmn:task id="A_Mahnen" name="Lieferanten mahnen"/>
    <bpmn:endEvent id="A_Gemahnt" name="Gemahnt"/>
    <bpmn:task id="A_Antworten" name="Rückfrage beantworten"/>
    <bpmn:endEvent id="A_Beantwortet" name="Beantwortet"/>
    <bpmn:task id="A_Reklamieren" name="Schaden reklamieren"/>
    <bpmn:endEvent id="A_Reklamiert" name="Reklamiert"/>
    <bpmn:sequenceFlow id="A1" sourceRef="A_Start" targetRef="A_Buchen"/>
    <bpmn:sequenceFlow id="A2" sourceRef="A_Buchen" targetRef="A_Liefern"/>
    <bpmn:sequenceFlow id="A3" sourceRef="A_Liefern" targetRef="A_Pruefen"/>
    <bpmn:sequenceFlow id="A4" sourceRef="A_Pruefen" targetRef="A_Rechnung"/>
    <bpmn:sequenceFlow id="A5" sourceRef="A_Rechnung" targetRef="A_Ende"/>
    <bpmn:sequenceFlow id="A6" name="erneut" sourceRef="A_Netz" targetRef="A_Buchen"/>
    <bpmn:sequenceFlow id="A7" sourceRef="A_Frist" targetRef="A_Mahnen"/>
    <bpmn:sequenceFlow id="A8" sourceRef="A_Mahnen" targetRef="A_Gemahnt"/>
    <bpmn:sequenceFlow id="A9" sourceRef="A_Frage" targetRef="A_Antworten"/>
    <bpmn:sequenceFlow id="A10" sourceRef="A_Antworten" targetRef="A_Beantwortet"/>
    <bpmn:sequenceFlow id="A11" sourceRef="A_Schaden" targetRef="A_Reklamieren"/>
    <bpmn:sequenceFlow id="A12" sourceRef="A_Reklamieren" targetRef="A_Reklamiert"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="dokufix_diagram">
    <bpmndi:BPMNPlane id="dokufix_plane" bpmnElement="Prozess_Angeheftet">
      <bpmndi:BPMNShape id="A_Start_di" bpmnElement="A_Start"><dc:Bounds x="102" y="72" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="75" y="112" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Buchen_di" bpmnElement="A_Buchen"><dc:Bounds x="210" y="50" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Liefern_di" bpmnElement="A_Liefern"><dc:Bounds x="378" y="50" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Pruefen_di" bpmnElement="A_Pruefen"><dc:Bounds x="546" y="50" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Rechnung_di" bpmnElement="A_Rechnung"><dc:Bounds x="714" y="50" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Ende_di" bpmnElement="A_Ende"><dc:Bounds x="906" y="72" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="879" y="112" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Mahnen_di" bpmnElement="A_Mahnen"><dc:Bounds x="546" y="316" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Gemahnt_di" bpmnElement="A_Gemahnt"><dc:Bounds x="906" y="338" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="879" y="378" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Antworten_di" bpmnElement="A_Antworten"><dc:Bounds x="546" y="440" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Beantwortet_di" bpmnElement="A_Beantwortet"><dc:Bounds x="906" y="462" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="879" y="502" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Reklamieren_di" bpmnElement="A_Reklamieren"><dc:Bounds x="714" y="192" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Reklamiert_di" bpmnElement="A_Reklamiert"><dc:Bounds x="906" y="214" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="879" y="254" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Netz_di" bpmnElement="A_Netz"><dc:Bounds x="252" y="112" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="275" y="134" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Frist_di" bpmnElement="A_Frist"><dc:Bounds x="442" y="112" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="465" y="134" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Frage_di" bpmnElement="A_Frage"><dc:Bounds x="398" y="112" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="321" y="150" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Schaden_di" bpmnElement="A_Schaden"><dc:Bounds x="616" y="112" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="632" y="134" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="A1_di" bpmnElement="A1"><di:waypoint x="138" y="90"/><di:waypoint x="210" y="90"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A2_di" bpmnElement="A2"><di:waypoint x="330" y="90"/><di:waypoint x="378" y="90"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A3_di" bpmnElement="A3"><di:waypoint x="498" y="90"/><di:waypoint x="546" y="90"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A4_di" bpmnElement="A4"><di:waypoint x="666" y="90"/><di:waypoint x="714" y="90"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A5_di" bpmnElement="A5"><di:waypoint x="834" y="90"/><di:waypoint x="906" y="90"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A6_di" bpmnElement="A6"><di:waypoint x="270" y="148"/><di:waypoint x="270" y="164"/><di:waypoint x="198" y="164"/><di:waypoint x="198" y="118"/><di:waypoint x="210" y="118"/><bpmndi:BPMNLabel><dc:Bounds x="214" y="168" width="40" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A7_di" bpmnElement="A7"><di:waypoint x="460" y="148"/><di:waypoint x="460" y="356"/><di:waypoint x="546" y="356"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A8_di" bpmnElement="A8"><di:waypoint x="666" y="356"/><di:waypoint x="906" y="356"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A9_di" bpmnElement="A9"><di:waypoint x="416" y="148"/><di:waypoint x="416" y="480"/><di:waypoint x="546" y="480"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A10_di" bpmnElement="A10"><di:waypoint x="666" y="480"/><di:waypoint x="906" y="480"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A11_di" bpmnElement="A11"><di:waypoint x="634" y="148"/><di:waypoint x="634" y="232"/><di:waypoint x="714" y="232"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A12_di" bpmnElement="A12"><di:waypoint x="834" y="232"/><di:waypoint x="906" y="232"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
