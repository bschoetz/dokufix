<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Hundemelken"
                  targetNamespace="http://example.com/bpmn">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Melkbetrieb" name="Hundemelkbetrieb" processRef="Process_Hundemelken" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Hundemelken" isExecutable="false">

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Melker" name="Melker">
        <bpmn:flowNodeRef>Start_Melkzeit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Desinfizieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge_Huendin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rufen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reinigen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Vormelken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Euter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Isolieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge_Ruhig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Ruhig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Beruhigen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Versuche</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AbbruchDok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge_Zitze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Melken</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Fluss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Anregen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Alle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ParSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Belohnen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ParJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge_Ende</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MelkstandReinigen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Weitere</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Huendin" name="Hündin">
        <bpmn:flowNodeRef>Task_Kommen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Abgeben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ausruhen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Tierarzt" name="Tierarzt">
        <bpmn:flowNodeRef>Task_Untersuchen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge_Behandlung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Behandeln</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Kontrolle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Geheilt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Karenz</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Verarbeitung" name="Verarbeitung">
        <bpmn:flowNodeRef>Task_Filtern</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sammeln</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sammelprobe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Nachprobe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Verwerfen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Verworfen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pasteurisieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Abkuehlen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Abfuellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge_Wiegen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Wiegen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Plausibel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Kalibrieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Kuehlen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Labor" name="Qualitätssicherung">
        <bpmn:flowNodeRef>GW_Merge_Probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Labor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Qualitaet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Nachprobe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dokumentieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Fertig</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Melkzeit" name="Melkzeit erreicht"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_Desinfizieren" name="Melkstand &amp; Equipment desinfizieren"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Merge_Huendin"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:incoming>Flow_44</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Rufen" name="Nächste Hündin zum Melkstand rufen"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Reinigen" name="Zitzen reinigen &amp; Euter massieren"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Vormelken" name="Vormelken &amp; Euter auf Entzündung prüfen"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Euter" name="Euter gesund?" default="Flow_9"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Isolieren" name="Hündin isolieren &amp; Tierarzt rufen"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Merge_Ruhig"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:incoming>Flow_25</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Pruefen" name="Verhalten der Hündin beurteilen"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Ruhig" name="Hündin ruhig?" default="Flow_21"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Beruhigen" name="Beruhigen &amp; Leckerli geben"><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Versuche" name="3 Versuche erreicht?" default="Flow_25"><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing><bpmn:outgoing>Flow_25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_AbbruchDok" name="Abbruch dokumentieren &amp; Hündin neu einplanen"><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Merge_Zitze"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:incoming>Flow_31</bpmn:incoming><bpmn:incoming>Flow_32</bpmn:incoming><bpmn:outgoing>Flow_26</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Melken" name="Nächste Zitze von Hand melken"><bpmn:incoming>Flow_26</bpmn:incoming><bpmn:outgoing>Flow_27</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Fluss" name="Milchfluss ausreichend?" default="Flow_30"><bpmn:incoming>Flow_28</bpmn:incoming><bpmn:outgoing>Flow_29</bpmn:outgoing><bpmn:outgoing>Flow_30</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Anregen" name="Milchfluss anregen (Streicheln, Welpenfoto zeigen)"><bpmn:incoming>Flow_30</bpmn:incoming><bpmn:outgoing>Flow_31</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Alle" name="Alle Zitzen gemolken?" default="Flow_32"><bpmn:incoming>Flow_29</bpmn:incoming><bpmn:outgoing>Flow_32</bpmn:outgoing><bpmn:outgoing>Flow_33</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="GW_ParSplit"><bpmn:incoming>Flow_33</bpmn:incoming><bpmn:outgoing>Flow_34</bpmn:outgoing><bpmn:outgoing>Flow_35</bpmn:outgoing><bpmn:outgoing>Flow_36</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:task id="Task_Belohnen" name="Hündin belohnen &amp; Zitzen desinfizieren"><bpmn:incoming>Flow_34</bpmn:incoming><bpmn:outgoing>Flow_38</bpmn:outgoing></bpmn:task>
    <bpmn:parallelGateway id="GW_ParJoin"><bpmn:incoming>Flow_38</bpmn:incoming><bpmn:incoming>Flow_39</bpmn:incoming><bpmn:incoming>Flow_40</bpmn:incoming><bpmn:outgoing>Flow_41</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_Merge_Ende"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:incoming>Flow_41</bpmn:incoming><bpmn:outgoing>Flow_42</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_MelkstandReinigen" name="Melkstand reinigen"><bpmn:incoming>Flow_42</bpmn:incoming><bpmn:outgoing>Flow_43</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Weitere" name="Weitere Hündin wartet?" default="Flow_44"><bpmn:incoming>Flow_43</bpmn:incoming><bpmn:outgoing>Flow_44</bpmn:outgoing><bpmn:outgoing>Flow_45</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Kommen" name="Zum Melkstand kommen &amp; ablegen"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Abgeben" name="Stillhalten &amp; Milch abgeben"><bpmn:incoming>Flow_27</bpmn:incoming><bpmn:outgoing>Flow_28</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Ausruhen" name="Wasser trinken &amp; ausruhen"><bpmn:incoming>Flow_35</bpmn:incoming><bpmn:outgoing>Flow_39</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Untersuchen" name="Euter untersuchen &amp; Diagnose stellen"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Merge_Behandlung"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Behandeln" name="Behandlung durchführen"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Kontrolle" name="Heilungsverlauf kontrollieren"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Geheilt" name="Entzündung abgeklungen?" default="Flow_15"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Karenz" name="Karenzzeit dokumentieren &amp; Hündin pausieren"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Filtern" name="Milch filtern"><bpmn:incoming>Flow_36</bpmn:incoming><bpmn:outgoing>Flow_37</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Sammeln" name="Milch in Sammelbehälter geben"><bpmn:incoming>Flow_37</bpmn:incoming><bpmn:outgoing>Flow_40</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Sammelprobe" name="Sammelprobe entnehmen"><bpmn:incoming>Flow_45</bpmn:incoming><bpmn:outgoing>Flow_46</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Nachprobe" name="Nachprobe entnehmen"><bpmn:incoming>Flow_52</bpmn:incoming><bpmn:outgoing>Flow_53</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Verwerfen" name="Charge verwerfen &amp; entsorgen"><bpmn:incoming>Flow_51</bpmn:incoming><bpmn:outgoing>Flow_54</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Verworfen" name="Charge verworfen"><bpmn:incoming>Flow_54</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_Pasteurisieren" name="Milch pasteurisieren"><bpmn:incoming>Flow_49</bpmn:incoming><bpmn:outgoing>Flow_55</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_Abkuehlen" name="15 Min abkühlen lassen"><bpmn:incoming>Flow_55</bpmn:incoming><bpmn:outgoing>Flow_56</bpmn:outgoing><bpmn:timerEventDefinition id="TimerEventDefinition_1"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_Abfuellen" name="In Flaschen abfüllen"><bpmn:incoming>Flow_56</bpmn:incoming><bpmn:outgoing>Flow_57</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Merge_Wiegen"><bpmn:incoming>Flow_57</bpmn:incoming><bpmn:incoming>Flow_62</bpmn:incoming><bpmn:outgoing>Flow_58</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Wiegen" name="Menge wiegen"><bpmn:incoming>Flow_58</bpmn:incoming><bpmn:outgoing>Flow_59</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Plausibel" name="Menge plausibel?" default="Flow_61"><bpmn:incoming>Flow_59</bpmn:incoming><bpmn:outgoing>Flow_60</bpmn:outgoing><bpmn:outgoing>Flow_61</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Kalibrieren" name="Waage kalibrieren"><bpmn:incoming>Flow_61</bpmn:incoming><bpmn:outgoing>Flow_62</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Kuehlen" name="Auf 4 °C kühlen &amp; etikettieren"><bpmn:incoming>Flow_60</bpmn:incoming><bpmn:outgoing>Flow_63</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Merge_Probe"><bpmn:incoming>Flow_46</bpmn:incoming><bpmn:incoming>Flow_53</bpmn:incoming><bpmn:outgoing>Flow_47</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Labor" name="Probe auf Keimzahl, Fett &amp; Eiweiß untersuchen"><bpmn:incoming>Flow_47</bpmn:incoming><bpmn:outgoing>Flow_48</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GW_Qualitaet" name="Qualität in Ordnung?" default="Flow_50"><bpmn:incoming>Flow_48</bpmn:incoming><bpmn:outgoing>Flow_49</bpmn:outgoing><bpmn:outgoing>Flow_50</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Nachprobe" name="Nachprobe bereits genommen?" default="Flow_52"><bpmn:incoming>Flow_50</bpmn:incoming><bpmn:outgoing>Flow_51</bpmn:outgoing><bpmn:outgoing>Flow_52</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_Dokumentieren" name="Charge dokumentieren &amp; freigeben"><bpmn:incoming>Flow_63</bpmn:incoming><bpmn:outgoing>Flow_64</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Fertig" name="Milch eingelagert"><bpmn:incoming>Flow_64</bpmn:incoming></bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1"  sourceRef="Start_Melkzeit" targetRef="Task_Desinfizieren" />
    <bpmn:sequenceFlow id="Flow_2"  sourceRef="Task_Desinfizieren" targetRef="GW_Merge_Huendin" />
    <bpmn:sequenceFlow id="Flow_3"  sourceRef="GW_Merge_Huendin" targetRef="Task_Rufen" />
    <bpmn:sequenceFlow id="Flow_4"  sourceRef="Task_Rufen" targetRef="Task_Kommen" />
    <bpmn:sequenceFlow id="Flow_5"  sourceRef="Task_Kommen" targetRef="Task_Reinigen" />
    <bpmn:sequenceFlow id="Flow_6"  sourceRef="Task_Reinigen" targetRef="Task_Vormelken" />
    <bpmn:sequenceFlow id="Flow_7"  sourceRef="Task_Vormelken" targetRef="GW_Euter" />
    <bpmn:sequenceFlow id="Flow_8"  name="ja" sourceRef="GW_Euter" targetRef="GW_Merge_Ruhig" />
