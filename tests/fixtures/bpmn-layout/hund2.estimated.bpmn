    <bpmn:sequenceFlow id="Flow_48" sourceRef="Task_Labor" targetRef="GW_Qualitaet" />
    <bpmn:sequenceFlow id="Flow_49" name="ja" sourceRef="GW_Qualitaet" targetRef="Task_Pasteurisieren" />
    <bpmn:sequenceFlow id="Flow_50" name="nein" sourceRef="GW_Qualitaet" targetRef="GW_Nachprobe" />
