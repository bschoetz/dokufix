<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitionen" targetNamespace="http://example.org/dokufix">
  <collaboration id="graph">
    <participant id="subgraph" name="Verlängerung" processRef="Process_1"/>
  </collaboration>
  <process id="Process_1" isExecutable="false">
    <startEvent id="start" name="Leserin fragt"/>
    <exclusiveGateway id="Flow_1" name="Vorgemerkt?"/>
    <task id="style" name="Frist verlängern"/>
    <task id="click" name="Bescheid geben"/>
    <endEvent id="end" name="Erledigt"/>
    <textAnnotation id="Notiz"><text>Höchstens zweimal</text></textAnnotation>
    <association id="Zur_Notiz" sourceRef="style" targetRef="Notiz"/>
    <sequenceFlow id="S1" sourceRef="start" targetRef="Flow_1"/>
    <sequenceFlow id="S2" sourceRef="Flow_1" targetRef="style" name="nein"/>
    <sequenceFlow id="S3" sourceRef="Flow_1" targetRef="style" name="ja, aber kurz"/>
    <sequenceFlow id="S4" sourceRef="style" targetRef="click"/>
    <sequenceFlow id="S5" sourceRef="click" targetRef="end"/>
  </process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="dokufix_diagram">
    <bpmndi:BPMNPlane id="dokufix_plane" bpmnElement="graph">
      <bpmndi:BPMNShape id="subgraph_di" bpmnElement="subgraph" isHorizontal="true"><dc:Bounds x="0" y="-45" width="776" height="189"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="102" y="54" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="75" y="94" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Flow_1_di" bpmnElement="Flow_1" isMarkerVisible="true"><dc:Bounds x="210" y="47" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="190" y="101" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="style_di" bpmnElement="style"><dc:Bounds x="308" y="32" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="click_di" bpmnElement="click"><dc:Bounds x="476" y="32" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="668" y="54" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="641" y="94" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Notiz_di" bpmnElement="Notiz"><dc:Bounds x="453" y="-33" width="150" height="40"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="S1_di" bpmnElement="S1"><di:waypoint x="138" y="72"/><di:waypoint x="210" y="72"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S2_di" bpmnElement="S2"><di:waypoint x="260" y="72"/><di:waypoint x="308" y="72"/><bpmndi:BPMNLabel><dc:Bounds x="270" y="53" width="23" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S3_di" bpmnElement="S3"><di:waypoint x="235" y="47"/><di:waypoint x="235" y="20"/><di:waypoint x="368" y="20"/><di:waypoint x="368" y="32"/><bpmndi:BPMNLabel><dc:Bounds x="162" y="24" width="67" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S4_di" bpmnElement="S4"><di:waypoint x="428" y="72"/><di:waypoint x="476" y="72"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="S5_di" bpmnElement="S5"><di:waypoint x="596" y="72"/><di:waypoint x="668" y="72"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Zur_Notiz_di" bpmnElement="Zur_Notiz"><di:waypoint x="408" y="32"/><di:waypoint x="453" y="-13"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
<!-- Ende des Modells -->
