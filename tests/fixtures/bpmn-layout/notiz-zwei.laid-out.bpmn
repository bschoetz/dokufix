      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="862" y="340"/><di:waypoint x="934" y="340"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a1_di" bpmnElement="a1"><di:waypoint x="270" y="32"/><di:waypoint x="270" y="-18"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a2_di" bpmnElement="a2"><di:waypoint x="309" y="32"/><di:waypoint x="355" y="-14"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a3_di" bpmnElement="a3"><di:waypoint x="268" y="147"/><di:waypoint x="387" y="81"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a4_di" bpmnElement="a4"><di:waypoint x="596" y="226"/><di:waypoint x="646" y="226"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a5_di" bpmnElement="a5"><di:waypoint x="969" y="341"/><di:waypoint x="1020" y="341"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
