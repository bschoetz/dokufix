  <bpmn:collaboration id="C"><bpmn:participant id="P" name="Pool" processRef="Proc"/></bpmn:collaboration>
  <bpmn:process id="Proc" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="Lane_1" name="Oben"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>a</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g</bpmn:flowNodeRef>
</bpmn:lane>
      <bpmn:lane id="Lane_2" name="Mitte"><bpmn:flowNodeRef>b</bpmn:flowNodeRef><bpmn:flowNodeRef>c</bpmn:flowNodeRef><bpmn:flowNodeRef>z</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_3" name="Unten"><bpmn:flowNodeRef>d</bpmn:flowNodeRef></bpmn:lane>
