      <bpmn:lane id="Lane_1" name="Up"><bpmn:flowNodeRef>u1</bpmn:flowNodeRef><bpmn:flowNodeRef>u2</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_2" name="Row"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>p1</bpmn:flowNodeRef><bpmn:flowNodeRef>x</bpmn:flowNodeRef><bpmn:flowNodeRef>y</bpmn:flowNodeRef><bpmn:flowNodeRef>p2</bpmn:flowNodeRef><bpmn:flowNodeRef>q</bpmn:flowNodeRef><bpmn:flowNodeRef>z</bpmn:flowNodeRef></bpmn:lane>
