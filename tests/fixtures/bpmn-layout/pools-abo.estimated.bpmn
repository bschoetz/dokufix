      <bpmndi:BPMNShape id="Lane_Formular_di" bpmnElement="Lane_Formular" isHorizontal="true"><dc:Bounds x="30" y="184" width="1180" height="144"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Kartei_di" bpmnElement="Lane_Kartei" isHorizontal="true"><dc:Bounds x="30" y="328" width="1180" height="144"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Touren_di" bpmnElement="Lane_Touren" isHorizontal="true"><dc:Bounds x="30" y="472" width="1180" height="144"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="K_Start_di" bpmnElement="K_Start"><dc:Bounds x="102" y="54" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="75" y="94" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
