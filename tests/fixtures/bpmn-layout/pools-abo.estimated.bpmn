      <bpmndi:BPMNShape id="K_Termin_di" bpmnElement="K_Termin"><dc:Bounds x="854" y="54" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="827" y="20" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="K_Ende_di" bpmnElement="K_Ende"><dc:Bounds x="1102" y="54" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1075" y="94" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Start_di" bpmnElement="F_Start"><dc:Bounds x="252" y="238" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="225" y="278" width="90" height="30"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Pruefen_di" bpmnElement="F_Pruefen"><dc:Bounds x="378" y="216" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Teilen_di" bpmnElement="F_Teilen"><dc:Bounds x="546" y="375" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Bestaetigen_di" bpmnElement="F_Bestaetigen"><dc:Bounds x="644" y="216" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Zusammen_di" bpmnElement="F_Zusammen"><dc:Bounds x="980" y="375" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Ende_di" bpmnElement="F_Ende"><dc:Bounds x="1102" y="382" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1075" y="422" width="90" height="15"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Liste_di" bpmnElement="B_Liste"><dc:Bounds x="644" y="360" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_Status_di" bpmnElement="B_Status"><dc:Bounds x="812" y="360" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Einplanen_di" bpmnElement="T_Einplanen"><dc:Bounds x="644" y="504" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Mitteilen_di" bpmnElement="T_Mitteilen"><dc:Bounds x="812" y="504" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="K1_di" bpmnElement="K1"><di:waypoint x="138" y="72"/><di:waypoint x="210" y="72"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="K2_di" bpmnElement="K2"><di:waypoint x="330" y="72"/><di:waypoint x="686" y="72"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="K3_di" bpmnElement="K3"><di:waypoint x="722" y="72"/><di:waypoint x="854" y="72"/></bpmndi:BPMNEdge>
