      <bpmn:lane id="Lane_Tourenplanung" name="Tourenplanung"><bpmn:flowNodeRef>v1</bpmn:flowNodeRef><bpmn:flowNodeRef>v2</bpmn:flowNodeRef><bpmn:flowNodeRef>v3</bpmn:flowNodeRef><bpmn:flowNodeRef>v4</bpmn:flowNodeRef><bpmn:flowNodeRef>w</bpmn:flowNodeRef><bpmn:flowNodeRef>z</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Möchte regelmäßig beliefert werden"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
