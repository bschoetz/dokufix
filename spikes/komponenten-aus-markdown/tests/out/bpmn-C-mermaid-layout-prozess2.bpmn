    <bpmn:endEvent id="e" name="Bestätigung erhalten"><bpmn:incoming>Flow_4</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="b" name="Pflichtfelder und Adresse prüfen"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="c" name="Bestätigung an den Kunden senden"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="x" name="Welche Tour?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway>
