  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_Kunde" name="Kunde" processRef="Process_Kunde"/>
    <bpmn:participant id="Pool_Shop" name="Shop" processRef="Process_Shop"/>
    <bpmn:participant id="Pool_Lieferant" name="Lieferant" processRef="Process_Lieferant"/>
    <bpmn:messageFlow id="M1" name="Bestellung" sourceRef="K_Bestellen" targetRef="S_Start"/>
    <bpmn:messageFlow id="M2" name="Nachbestellung" sourceRef="S_Nachbestellen" targetRef="L_Start"/>
    <bpmn:messageFlow id="M3" name="Lieferung" sourceRef="L_Liefern" targetRef="S_Wareneingang"/>
    <bpmn:messageFlow id="M4" name="Paket" sourceRef="S_Versenden" targetRef="K_Paket"/>
    <bpmn:messageFlow id="M5" name="Absage" sourceRef="S_Absagen" targetRef="K_Absage"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Kunde" isExecutable="false">
    <bpmn:startEvent id="K_Start" name="Braucht Ware"/>
    <bpmn:sendTask id="K_Bestellen" name="Bestellen"/>
    <bpmn:eventBasedGateway id="K_Warten"/>
    <bpmn:intermediateCatchEvent id="K_Paket" name="Paket erhalten"><bpmn:messageEventDefinition id="K_Paket_def"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="K_Absage" name="Absage erhalten"><bpmn:messageEventDefinition id="K_Absage_def"/></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="K_Ende" name="Versorgt"/>
    <bpmn:endEvent id="K_Ende2" name="Sucht woanders"/>
    <bpmn:sequenceFlow id="K1" sourceRef="K_Start" targetRef="K_Bestellen"/>
    <bpmn:sequenceFlow id="K2" sourceRef="K_Bestellen" targetRef="K_Warten"/>
    <bpmn:sequenceFlow id="K3" sourceRef="K_Warten" targetRef="K_Paket"/>
    <bpmn:sequenceFlow id="K4" sourceRef="K_Warten" targetRef="K_Absage"/>
    <bpmn:sequenceFlow id="K5" sourceRef="K_Paket" targetRef="K_Ende"/>
    <bpmn:sequenceFlow id="K6" sourceRef="K_Absage" targetRef="K_Ende2"/>
  </bpmn:process>
  <bpmn:process id="Process_Shop" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Shop">
      <bpmn:lane id="Lane_Vertrieb" name="Vertrieb"><bpmn:flowNodeRef>S_Start</bpmn:flowNodeRef><bpmn:flowNodeRef>S_Pruefen</bpmn:flowNodeRef><bpmn:flowNodeRef>S_Lieferbar</bpmn:flowNodeRef><bpmn:flowNodeRef>S_Absagen</bpmn:flowNodeRef><bpmn:flowNodeRef>S_EndeAbsage</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Lager" name="Lager"><bpmn:flowNodeRef>S_Vorrat</bpmn:flowNodeRef><bpmn:flowNodeRef>S_Nachbestellen</bpmn:flowNodeRef><bpmn:flowNodeRef>S_Wareneingang</bpmn:flowNodeRef><bpmn:flowNodeRef>S_Versenden</bpmn:flowNodeRef><bpmn:flowNodeRef>S_Ende</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_Start" name="Bestellung eingegangen"><bpmn:messageEventDefinition id="S_Start_def"/></bpmn:startEvent>
    <bpmn:userTask id="S_Pruefen" name="Bestellung prüfen"/>
    <bpmn:exclusiveGateway id="S_Lieferbar" name="Lieferbar?"/>
    <bpmn:sendTask id="S_Absagen" name="Absage senden"/>
    <bpmn:endEvent id="S_EndeAbsage" name="Abgesagt"/>
    <bpmn:exclusiveGateway id="S_Vorrat" name="Auf Lager?"/>
    <bpmn:sendTask id="S_Nachbestellen" name="Beim Lieferanten nachbestellen"/>
    <bpmn:intermediateCatchEvent id="S_Wareneingang" name="Ware eingetroffen"><bpmn:messageEventDefinition id="S_Wareneingang_def"/></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="S_Versenden" name="Paket versenden"/>
    <bpmn:endEvent id="S_Ende" name="Versendet"/>
    <bpmn:sequenceFlow id="S1" sourceRef="S_Start" targetRef="S_Pruefen"/>
    <bpmn:sequenceFlow id="S2" sourceRef="S_Pruefen" targetRef="S_Lieferbar"/>
    <bpmn:sequenceFlow id="S3" name="nein" sourceRef="S_Lieferbar" targetRef="S_Absagen"/>
    <bpmn:sequenceFlow id="S4" sourceRef="S_Absagen" targetRef="S_EndeAbsage"/>
