    <bpmn:sequenceFlow id="Flow_5" sourceRef="d" targetRef="f"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="d" targetRef="g"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="g" targetRef="e"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="f" targetRef="x"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="x" targetRef="n" name="nein"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="x" targetRef="h" name="ja"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="h" targetRef="y"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="y" targetRef="i" name="ja"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="y" targetRef="z" name="nein"/>
  </bpmn:process>
