  <bpmn:collaboration id="Collaboration_1"><bpmn:participant id="Participant_1" name="Probekiste" processRef="Process_1"/></bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Kunde" name="Kunde"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>a</bpmn:flowNodeRef><bpmn:flowNodeRef>c</bpmn:flowNodeRef><bpmn:flowNodeRef>e</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Website" name="Website"><bpmn:flowNodeRef>b</bpmn:flowNodeRef><bpmn:flowNodeRef>g</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Kundenkartei" name="Kundenkartei"><bpmn:flowNodeRef>d</bpmn:flowNodeRef><bpmn:flowNodeRef>f</bpmn:flowNodeRef><bpmn:flowNodeRef>x</bpmn:flowNodeRef><bpmn:flowNodeRef>n</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Hofb_ro" name="Hofbüro"><bpmn:flowNodeRef>h</bpmn:flowNodeRef><bpmn:flowNodeRef>y</bpmn:flowNodeRef><bpmn:flowNodeRef>i</bpmn:flowNodeRef><bpmn:flowNodeRef>z</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Probekiste entdeckt"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="a" name="Bestellung ausfüllen und absenden"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="c" name="Bestellung per Link bestätigen"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="e" name="Probekiste erhalten"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="b" name="Bestätigungsmail senden eine Vorlage für alle"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="g" name="Lieferauftrag an die nächste Tour"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="d" name="Kunde anlegen oder ergänzen"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="f" name="Kistenart, Datum und Status eintragen"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="x" name="Erinnerungen erlaubt?"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="n" name="Einmalkunde, keine Erinnerung"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="h" name="Erinnerungsmails 3 Mails, 3 Wochen"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="y" name="Reaktion?"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="i" name="Übergabe an die Tourenplanung, Prozess 2"><bpmn:incoming>Flow_12</bpmn:incoming></bpmn:task>
    <bpmn:endEvent id="z" name="Mails beendet, bleibt erreichbar"><bpmn:incoming>Flow_13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="a"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="a" targetRef="b"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="b" targetRef="c" name="Bestätigungsmail"/>
